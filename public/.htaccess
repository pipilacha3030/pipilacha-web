# ---- WebP por negociación de contenido ----
# Si el navegador acepta webp y existe el hermano .webp, se sirve con el MISMO URL.
# Cubre <img>, srcset y fondos CSS sin tocar el markup. Si el módulo no está
# o falta el .webp, se sirve el original: degradación limpia.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
  RewriteRule ^(.+)\.(?:jpe?g|png)$ $1.webp [T=image/webp,L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Bundles con hash en el nombre (/_assets/ de Astro): cache eterna de verdad
  <If "%{REQUEST_URI} =~ m#^/_assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Resto de estáticos (imágenes, fuentes): un mes, revalidable
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # la respuesta jpg/png varía según Accept (negociación webp de arriba)
  <FilesMatch "\.(jpg|jpeg|png)$">
    Header append Vary Accept
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

# ---- Cabeceras de seguridad ----
# CSP: solo scripts propios + el iframeResizer de Bonkdo + los DOS inline
# permitidos por hash (la clase `js` de Base.astro y el iFrameResize() de
# regala). Si cambias cualquiera de esos <script is:inline>, recalcula:
#   printf '%s' "<contenido exacto>" | openssl dgst -sha256 -binary | openssl base64
# frame-src con comodín de vendor: los widgets (TheFork/Bonkdo) pueden navegar
# su propio iframe a hosts hermanos; cerrarlo más rompería reservas/compras.
# 'unsafe-inline' SOLO en estilos (Astro emite <style> y style= inline); en
# scripts NO hay unsafe-inline: un XSS inyectado no ejecutaría.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://*.bonkdo.com 'sha256-98B9qXIvmuDpTxEU4CQI4PON9NbP1zKueDjwTB+7nPY=' 'sha256-52ptapa6zOH4jdYhAXJ3dkR28YXcon7MfaU19Af4VFk='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://*.thefork.com https://*.bonkdo.com https://checkout.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS moderado (6 meses, sin preload): la beta ya sirve https
  Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>
