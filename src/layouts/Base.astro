---
// Layout común a todas las páginas (nav + footer + scripts compartidos).
import '../styles/main.css';

const {
  title,
  description,
  ogImage = '/assets/img/og.jpg', // imagen al compartir el enlace: los dos chefs en El Retiro
  solidNav = true, // nav sólida sobre cream; en el Inicio va transparente sobre el hero
  schema,          // JSON-LD opcional por página (string ya serializado)
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const here = (href) => path === href;
// URLs absolutas (Astro.site = dominio final) para canonical, OG y schema
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageAbs = new URL(ogImage, Astro.site).href;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Pipilacha" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:url" content={canonical} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/img/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />

  {here('/') && (
    <link rel="preload" as="image" href="/assets/img/hero.jpg"
      imagesrcset="/assets/img/hero-m.jpg 900w, /assets/img/hero.jpg 2400w"
      imagesizes="100vw" fetchpriority="high" />
  )}

  <!-- tipografías auto-alojadas (@font-face en main.css); preload de las dos críticas -->
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/marcellus-400-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/hanken-grotesk-variable-latin.woff2" crossorigin />

  {here('/') && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Restaurant",
      "name": "Pipilacha",
      "description": "El único restaurante del mundo construido íntegramente sobre las flores. Menú de degustación en Madrid.",
      "servesCuisine": "Cocina floral de autor",
      "priceRange": "€€€",
      "image": new URL('/assets/img/hero.jpg', Astro.site).href,
      "url": Astro.site.href,
      "telephone": "+34919125998",
      "acceptsReservations": "https://widget.thefork.com/867dcee9-49b5-47ed-90c0-c6c87149b328",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C. del Azulejo, 2",
        "addressLocality": "Madrid",
        "postalCode": "28028",
        "addressCountry": "ES"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": 40.4291, "longitude": -3.6669 },
      "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Thursday","Friday","Saturday","Sunday"], "opens": "14:00", "closes": "16:30" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Thursday","Friday","Saturday","Sunday"], "opens": "21:00", "closes": "23:30" }
      ],
      "sameAs": ["https://instagram.com/restaurante.pipilacha"]
    })} />
  )}
  {schema && <Fragment set:html={schema} />}
</head>
<body>

  <!-- Transición entre páginas: fondo olive + isotipo de la libélula animado -->
  <div class="page-transition" id="pageTransition" aria-hidden="true">
    <img src="/assets/img/iso-light.png" class="page-transition__mark" alt="" />
  </div>
  <noscript><style>.page-transition{display:none!important}</style></noscript>

  <!-- NAV -->
  <header class={`nav${solidNav ? ' nav--solid' : ''}`} id="nav">
    <a href="/" class="nav__logo" aria-label="Pipilacha inicio">
      <img src="/assets/img/logo-light.png" class="nav__logo-img nav__logo-img--light" alt="Pipilacha" width="560" height="216" />
      <img src="/assets/img/logo-dark.png" class="nav__logo-img nav__logo-img--dark" alt="" aria-hidden="true" width="560" height="216" />
      <img src="/assets/img/iso-light.png" class="nav__logo-iso" alt="Pipilacha" width="200" height="200" />
    </a>
    <nav class="nav__links" id="navLinks">
      <a href="/conocenos/" aria-current={here('/conocenos') ? 'page' : undefined}>Conócenos</a>
      <a href="/menu/" aria-current={here('/menu') ? 'page' : undefined}>Menú</a>
      <a href="/vinos/" aria-current={here('/vinos') ? 'page' : undefined}>Vinos</a>
      <a href="/galeria/" aria-current={here('/galeria') ? 'page' : undefined}>Galería</a>
      <a href="/prensa/" aria-current={here('/prensa') ? 'page' : undefined}>Prensa</a>
      <a href="/regala/" aria-current={here('/regala') ? 'page' : undefined}>Regalar</a>
      <a href="/reservas/" class="nav__cta">Reservar</a>
    </nav>
    <button class="nav__burger" id="burger" aria-label="Abrir menú" aria-controls="navLinks" aria-expanded="false"><span></span><span></span><span></span></button>
  </header>

  <main>
    <slot />
  </main>

  {path !== '/reservas' && (
    <a href="/reservas/" class="reserva-bar" id="reservaBar">Reservar</a>
  )}

  <!-- FOOTER (estático, sin animación) -->
  <footer class="footer" id="footer">
    <div class="footer__brand">
      <img src="/assets/img/logo-light.png" class="footer__logo" alt="Pipilacha" width="560" height="216" />
      <p>El único restaurante del mundo construido íntegramente sobre las flores.</p>
    </div>
    <div class="footer__cols">
      <div>
        <h4>Horario</h4>
        <p>Jueves a domingo<br>Comida 14:00 · Cena 21:00<br>16 plazas por servicio</p>
      </div>
      <div>
        <h4>Ubicación</h4>
        <p>C. del Azulejo, 2<br>28028 Madrid</p>
        <a href="https://maps.google.com/?q=C.+del+Azulejo+2+28028+Madrid" target="_blank" rel="noopener">Cómo llegar →</a>
      </div>
      <div>
        <h4>Contacto</h4>
        <p><a href="https://instagram.com/restaurante.pipilacha" target="_blank" rel="noopener">@restaurante.pipilacha</a><br><a href="tel:+34919125998">+34 919 12 59 98</a><br><a href="mailto:info@pipilacha.es">info@pipilacha.es</a></p>
      </div>
    </div>
    <nav class="footer__nav" aria-label="Páginas">
      <a href="/conocenos/">Conócenos</a>
      <a href="/menu/">Menú</a>
      <a href="/vinos/">Vinos</a>
      <a href="/galeria/">Galería</a>
      <a href="/prensa/">Prensa</a>
      <a href="/regala/">Regalar</a>
      <a href="/reservas/">Reservar</a>
    </nav>
    <div class="footer__base">
      <span>© 2026 Pipilacha</span>
      <span>Madrid</span>
    </div>
  </footer>

  <!-- Interacción: Lenis + GSAP importados desde npm dentro del bundle de src/scripts/
       (Vite lo minifica y hashea el nombre → cache busting automático, sin ?v=N) -->
  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
