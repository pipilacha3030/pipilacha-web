---
// Layout común a todas las páginas (nav + footer + scripts compartidos).
import '../styles/main.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description,
  ogImage = '/assets/img/og.jpg', // imagen al compartir el enlace: los dos chefs en El Retiro
  schema,          // JSON-LD opcional por página (string ya serializado)
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const here = (href) => path === href;
// URLs absolutas (Astro.site = dominio final) para canonical, OG y schema
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageAbs = new URL(ogImage, Astro.site).href;

/* ---------- Grafo schema.org (todas las páginas) ----------
   Entidades con @id estable para que buscadores y LLMs conecten
   Pipilacha → restaurante → Madrid → flores comestibles → menú →
   chefs. Las páginas pueden ampliar nodos vía la prop `schema`
   (mismo @id = las propiedades se fusionan). */
const SITE = Astro.site.href;
const ID = { restaurant: `${SITE}#restaurant`, website: `${SITE}#website`, aran: `${SITE}#aran`, noe: `${SITE}#noe` };
const breadcrumbNames = {
  '/conocenos': 'Conócenos', '/menu': 'Menú', '/vinos': 'Vinos', '/galeria': 'Galería',
  '/prensa': 'Prensa', '/regala': 'Regalar', '/reservas': 'Reservas',
};
const graph = [
  {
    "@type": "Restaurant",
    "@id": ID.restaurant,
    "name": "Pipilacha",
    "description": "El único restaurante del mundo construido íntegramente sobre las flores. Menú de degustación de quince pases con flores comestibles como ingrediente principal, en Madrid.",
    "url": SITE,
    "image": new URL('/assets/img/hero.jpg', Astro.site).href,
    "servesCuisine": "Cocina floral de autor",
    "priceRange": "€€€",
    "telephone": "+34919125998",
    "email": "info@pipilacha.es",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "C. del Azulejo, 2",
      "addressLocality": "Madrid",
      "postalCode": "28028",
      "addressCountry": "ES"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": 40.4291, "longitude": -3.6669 },
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Thursday","Friday","Saturday","Sunday"], "opens": "14:00", "closes": "16:30" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Thursday","Friday","Saturday","Sunday"], "opens": "21:00", "closes": "23:30" }
    ],
    "acceptsReservations": "https://widget.thefork.com/867dcee9-49b5-47ed-90c0-c6c87149b328",
    "hasMenu": [`${SITE}menu/`, `${SITE}vinos/`],
    "founder": [{ "@id": ID.aran }, { "@id": ID.noe }],
    "knowsAbout": [
      "Flores comestibles",
      "Cocina floral de autor",
      "Menú de degustación",
      "Investigación botánica aplicada a la gastronomía",
      "Fermentación de flores"
    ],
    "sameAs": ["https://instagram.com/restaurante.pipilacha"]
  },
  {
    "@type": "Person",
    "@id": ID.aran,
    "name": "Arán Rodrigo",
    "jobTitle": "Chef y cofundador",
    "worksFor": { "@id": ID.restaurant },
    "knowsAbout": ["Flores comestibles", "Alta cocina", "Investigación botánica aplicada a la gastronomía"]
  },
  {
    "@type": "Person",
    "@id": ID.noe,
    "name": "Noé David",
    "jobTitle": "Chef y cofundador",
    "worksFor": { "@id": ID.restaurant },
    "knowsAbout": ["Flores comestibles", "Alta cocina", "Fermentación de flores"]
  },
  {
    "@type": "WebSite",
    "@id": ID.website,
    "url": SITE,
    "name": "Pipilacha",
    "inLanguage": "es",
    "publisher": { "@id": ID.restaurant }
  },
];
if (path !== '/' && breadcrumbNames[path]) {
  graph.push({
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": SITE },
      { "@type": "ListItem", "position": 2, "name": breadcrumbNames[path], "item": canonical }
    ]
  });
}
const graphJson = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });
---

<!DOCTYPE html>
<html lang="es">
<head>
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Pipilacha" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Arán y Noé, los chefs de Pipilacha, entre flores" />
  <meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#F4EFE6" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/img/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />

  {here('/') && (
    <link rel="preload" as="image" href="/assets/img/hero.jpg"
      imagesrcset="/assets/img/hero-m.jpg 900w, /assets/img/hero.jpg 2400w"
      imagesizes="100vw" fetchpriority="high" />
  )}

  <!-- tipografías auto-alojadas (@font-face en main.css); preload de las dos críticas -->
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/marcellus-400-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/hanken-grotesk-variable-latin.woff2" crossorigin />

  <script type="application/ld+json" is:inline set:html={graphJson} />
  {schema && <Fragment set:html={schema} />}
</head>
<body>

  <!-- Transición entre páginas: fondo olive + isotipo de la libélula animado -->
  <div class="page-transition" id="pageTransition" aria-hidden="true">
    <img src="/assets/img/iso-light.png" class="page-transition__mark" alt="" />
  </div>
  <noscript><style>.page-transition{display:none!important}</style></noscript>

  <Nav path={path} />

  <main>
    <slot />
  </main>

  {path !== '/reservas' && (
    <a href="/reservas/" class="reserva-bar" id="reservaBar">Reservar</a>
  )}

  <Footer />

  <!-- Interacción: Lenis + GSAP importados desde npm dentro del bundle de src/scripts/
       (Vite lo minifica y hashea el nombre → cache busting automático, sin ?v=N) -->
  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
