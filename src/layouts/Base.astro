---
// Layout común a todas las páginas (nav + footer + scripts compartidos).
import '../styles/main.css';

const {
  title,
  description,
  ogImage = '/assets/img/hero.jpg',
  solidNav = true, // nav sólida sobre cream; en el Inicio va transparente sobre el hero
  intro = false,   // la portada disruptiva solo se monta en el Inicio
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const here = (href) => path === href;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <link rel="icon" type="image/png" href="/assets/img/petal-fig.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Hanken+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": "Pipilacha",
    "description": "El único restaurante del mundo construido íntegramente sobre las flores. Menú de degustación en Madrid.",
    "servesCuisine": "Cocina floral de autor",
    "priceRange": "€€€",
    "image": "https://astounding-halva-485c9a.netlify.app/assets/img/hero.jpg",
    "url": "https://astounding-halva-485c9a.netlify.app/",
    "telephone": "+34919125998",
    "acceptsReservations": "https://widget.thefork.com/867dcee9-49b5-47ed-90c0-c6c87149b328",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "C. del Azulejo, 2",
      "addressLocality": "Madrid",
      "postalCode": "28028",
      "addressCountry": "ES"
    },
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Thursday","Friday","Saturday","Sunday"], "opens": "14:00", "closes": "16:30" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Thursday","Friday","Saturday","Sunday"], "opens": "21:00", "closes": "23:30" }
    ],
    "sameAs": ["https://instagram.com/restaurante.pipilacha"]
  })} />
</head>
<body>

  <!-- Transición entre páginas: fondo olive + isotipo de la libélula animado -->
  <div class="page-transition" id="pageTransition" aria-hidden="true">
    <img src="/assets/img/iso-light.png" class="page-transition__mark" alt="" />
  </div>
  <noscript><style>.page-transition{display:none!important}</style></noscript>

  {intro && (
    <div class="intro" id="intro" role="dialog" aria-label="Bienvenida a Pipilacha">
      <div class="intro__garden" aria-hidden="true">
        <img src="/assets/img/petal-borraja.png" class="intro__petal intro__petal--1" alt="" loading="eager" />
        <img src="/assets/img/petal-oxalis.png" class="intro__petal intro__petal--2" alt="" loading="eager" />
        <img src="/assets/img/petal-fig.png" class="intro__petal intro__petal--3" alt="" loading="eager" />
        <img src="/assets/img/petal-fig.png" class="intro__petal intro__petal--4" alt="" loading="eager" />
        <img src="/assets/img/petal-roja.png" class="intro__petal intro__petal--5" alt="" loading="eager" />
        <img src="/assets/img/petal-borraja.png" class="intro__petal intro__petal--6" alt="" loading="eager" />
      </div>
      <img src="/assets/img/iso-light.png" class="intro__mark" alt="" aria-hidden="true" />
      <div class="intro__inner">
        <div class="intro__ask" id="introAsk">
          <p class="intro__q">
            <span class="sr-only">¿Alguna vez has comido flores?</span>
            <span aria-hidden="true">¿Alguna vez has comido<br><span class="intro__word" id="introWord">flores</span>?</span>
          </p>
          <div class="intro__choices">
            <button type="button" class="intro__choice" data-answer="si">Sí</button>
            <button type="button" class="intro__choice" data-answer="no">No</button>
          </div>
        </div>
        <div class="intro__reply is-fading" id="introReply" hidden>
          <p class="intro__line" id="introLine"></p>
          <button type="button" class="intro__enter" id="introEnter">Pasa <span aria-hidden="true">→</span></button>
        </div>
      </div>
    </div>
  )}

  <!-- NAV -->
  <header class={`nav${solidNav ? ' nav--solid' : ''}`} id="nav">
    <a href="/" class="nav__logo" aria-label="Pipilacha inicio">
      <img src="/assets/img/logo-light.png" class="nav__logo-img nav__logo-img--light" alt="Pipilacha" width="560" height="216" />
      <img src="/assets/img/logo-dark.png" class="nav__logo-img nav__logo-img--dark" alt="" aria-hidden="true" width="560" height="216" />
      <img src="/assets/img/iso-light.png" class="nav__logo-iso" alt="Pipilacha" width="200" height="200" />
    </a>
    <nav class="nav__links">
      <a href="/conocenos/" aria-current={here('/conocenos') ? 'page' : undefined}>Conócenos</a>
      <a href="/menu/" aria-current={here('/menu') ? 'page' : undefined}>Menú</a>
      <a href="/vinos/" aria-current={here('/vinos') ? 'page' : undefined}>Vinos</a>
      <a href="/galeria/" aria-current={here('/galeria') ? 'page' : undefined}>Galería</a>
      <a href="/prensa/" aria-current={here('/prensa') ? 'page' : undefined}>Prensa</a>
      <a href="/regala/" aria-current={here('/regala') ? 'page' : undefined}>Regalar</a>
      <a href="/reservas/" class="nav__cta">Reservar</a>
    </nav>
    <button class="nav__burger" id="burger" aria-label="Abrir menú"><span></span><span></span></button>
  </header>

  <main>
    <slot />
  </main>

  {path !== '/reservas' && (
    <a href="/reservas/" class="reserva-bar" id="reservaBar">Reservar</a>
  )}

  <!-- FOOTER (estático, sin animación) -->
  <footer class="footer" id="footer">
    <div class="footer__brand">
      <img src="/assets/img/logo-light.png" class="footer__logo" alt="Pipilacha" width="560" height="216" />
      <p>El único restaurante del mundo construido íntegramente sobre las flores.</p>
    </div>
    <div class="footer__cols">
      <div>
        <h4>Horario</h4>
        <p>Jueves a domingo<br>Comida 14:00 · Cena 21:00<br>16 plazas por servicio</p>
      </div>
      <div>
        <h4>Ubicación</h4>
        <p>C. del Azulejo, 2<br>28028 Madrid</p>
        <a href="https://maps.google.com/?q=C.+del+Azulejo+2+28028+Madrid" target="_blank" rel="noopener">Cómo llegar →</a>
      </div>
      <div>
        <h4>Contacto</h4>
        <p><a href="https://instagram.com/restaurante.pipilacha" target="_blank" rel="noopener">@restaurante.pipilacha</a><br><a href="tel:+34919125998">+34 919 12 59 98</a></p>
      </div>
    </div>
    <nav class="footer__nav" aria-label="Páginas">
      <a href="/conocenos/">Conócenos</a>
      <a href="/menu/">Menú</a>
      <a href="/vinos/">Vinos</a>
      <a href="/galeria/">Galería</a>
      <a href="/prensa/">Prensa</a>
      <a href="/regala/">Regalar</a>
      <a href="/reservas/">Reservar</a>
    </nav>
    <div class="footer__base">
      <span>© 2026 Pipilacha</span>
      <span>Madrid</span>
    </div>
  </footer>

  <!-- Lenis (scroll suave) + GSAP (animaciones) — auto-alojados (npm), sin CDN -->
  <script is:inline src="/js/vendor/lenis.min.js"></script>
  <script is:inline src="/js/vendor/gsap.min.js"></script>
  <script is:inline src="/js/vendor/ScrollTrigger.min.js"></script>
  <script is:inline src="/js/main.js?v=28"></script>
</body>
</html>
