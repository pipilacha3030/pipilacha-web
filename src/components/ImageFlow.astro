---
import '../styles/imageFlow.css';

interface Card {
  src: string;
  w: number;
  h: number;
  top: number;    // vh — vertical position within sticky 100vh frame
  rotate: number; // deg, -6 to +6
  speed: number;  // depth multiplier (0.7 = far/slow, 1.5 = near/fast)
  offset: number; // 0–1, scroll progress at which this card crosses viewport center
  layer: 1 | 2 | 3;
}

/*
  3 depth layers — each card is absolutely positioned within the sticky pin frame.
  Layer 1 = far (slow, small, slightly dim/blurred)
  Layer 2 = mid (base speed and scale)
  Layer 3 = near (fast, large, sharp, dominant)

  offsets spread cards evenly across the scroll so 6–10 are always visible at once.
  Staggering within each layer avoids clumping on the same horizontal band.
*/
const cards: Card[] = [
  // ── LAYER 1 · far plane ─────────────────────────────────
  { src:'/assets/img/g1.jpg',               w:256, h:362, top: 7,  rotate:-3.5, speed:0.72, offset:0.05, layer:1 },
  { src:'/assets/img/g7.jpg',               w:252, h:189, top:62,  rotate: 2.5, speed:0.76, offset:0.22, layer:1 },
  { src:'/assets/img/g13.jpg',              w:262, h:370, top:11,  rotate:-2.0, speed:0.73, offset:0.42, layer:1 },
  { src:'/assets/img/df-guisante.jpg',      w:248, h:186, top:57,  rotate: 4.0, speed:0.78, offset:0.62, layer:1 },
  { src:'/assets/img/g4.jpg',               w:258, h:365, top:20,  rotate:-4.5, speed:0.70, offset:0.80, layer:1 },

  // ── LAYER 2 · mid plane ─────────────────────────────────
  { src:'/assets/img/g2.jpg',               w:380, h:255, top:38,  rotate: 2.0, speed:0.96, offset:0.08, layer:2 },
  { src:'/assets/img/g5.jpg',               w:358, h:507, top: 5,  rotate:-2.5, speed:1.00, offset:0.20, layer:2 },
  { src:'/assets/img/chef-3.jpg',           w:348, h:492, top: 8,  rotate: 1.5, speed:0.98, offset:0.32, layer:2 },
  { src:'/assets/img/g9.jpg',               w:392, h:263, top:44,  rotate:-3.0, speed:1.02, offset:0.46, layer:2 },
  { src:'/assets/img/g14.jpg',              w:368, h:521, top: 6,  rotate: 2.5, speed:0.97, offset:0.60, layer:2 },
  { src:'/assets/img/g11.jpg',              w:382, h:257, top:47,  rotate:-1.5, speed:1.01, offset:0.74, layer:2 },
  { src:'/assets/img/esparragos-tagete.jpg',w:362, h:243, top:30,  rotate: 3.0, speed:1.04, offset:0.88, layer:2 },

  // ── LAYER 3 · near plane ────────────────────────────────
  { src:'/assets/img/g3.jpg',               w:510, h:343, top:22,  rotate:-1.5, speed:1.35, offset:0.04, layer:3 },
  { src:'/assets/img/chef-1.jpg',           w:476, h:674, top: 4,  rotate: 2.0, speed:1.40, offset:0.16, layer:3 },
  { src:'/assets/img/g6.jpg',               w:498, h:335, top:42,  rotate:-2.5, speed:1.31, offset:0.28, layer:3 },
  { src:'/assets/img/g12.jpg',              w:488, h:690, top: 5,  rotate: 1.8, speed:1.45, offset:0.40, layer:3 },
  { src:'/assets/img/chef-2.jpg',           w:516, h:347, top:26,  rotate:-1.0, speed:1.38, offset:0.54, layer:3 },
  { src:'/assets/img/g17.jpg',              w:472, h:668, top: 8,  rotate: 2.5, speed:1.42, offset:0.66, layer:3 },
  { src:'/assets/img/df-vieira.jpg',        w:502, h:338, top:38,  rotate:-3.0, speed:1.36, offset:0.78, layer:3 },
  { src:'/assets/img/noe-barra.jpg',        w:492, h:330, top:48,  rotate: 1.5, speed:1.50, offset:0.90, layer:3 },
];
---

<section class="image-flow" aria-hidden="true" data-image-flow>
  <div class="image-flow__pin">
    {cards.map(card => (
      <div
        class={`image-flow__card image-flow__card--l${card.layer}`}
        data-speed={card.speed}
        data-rotate={card.rotate}
        data-offset={card.offset}
        data-layer={card.layer}
        style={`width:${card.w}px; height:${card.h}px; top:${card.top}vh; z-index:${card.layer * 10};`}
      >
        <img src={card.src} alt="" loading="lazy" decoding="async" />
      </div>
    ))}
  </div>
</section>

<script>
  import { initImageFlow } from '../scripts/imageFlow';
  // Module scripts are deferred — DOM + GSAP globals are ready by the time this runs
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImageFlow);
  } else {
    initImageFlow();
  }
</script>
