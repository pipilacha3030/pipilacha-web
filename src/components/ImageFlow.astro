---
import '../styles/imageFlow.css';

/*
 * 24 cards across 3 depth layers.
 * Same-layer phases are ~0.13 apart; layers are interleaved so
 * no two cards peak at the same scroll position.
 * Y positions alternate top/bottom to keep cards spatially separated.
 */
const cards = [
  // Layer 1 — far: slow · petite · background depth
  { src:'/assets/img/g3.jpg',    p:0.02, l:1, y:8,  w:244, h:324, r:-2.0 },
  { src:'/assets/img/g7.jpg',    p:0.15, l:1, y:56, w:232, h:174, r: 2.5 },
  { src:'/assets/img/g11.jpg',   p:0.28, l:1, y:24, w:256, h:360, r:-1.5 },
  { src:'/assets/img/dish-3.jpg',p:0.41, l:1, y:60, w:248, h:186, r: 3.0 },
  { src:'/assets/img/g4.jpg',    p:0.54, l:1, y:18, w:240, h:338, r:-2.5 },
  { src:'/assets/img/g8.jpg',    p:0.67, l:1, y:52, w:252, h:189, r: 1.5 },
  { src:'/assets/img/g12.jpg',   p:0.80, l:1, y:62, w:244, h:342, r:-2.0 },
  { src:'/assets/img/g13.jpg',   p:0.93, l:1, y:10, w:236, h:177, r: 2.0 },

  // Layer 2 — mid: standard depth
  { src:'/assets/img/g1.jpg',    p:0.06, l:2, y:40, w:348, h:462, r: 1.5 },
  { src:'/assets/img/chef-2.jpg',p:0.19, l:2, y:12, w:352, h:494, r:-2.0 },
  { src:'/assets/img/g5.jpg',    p:0.32, l:2, y:58, w:376, h:252, r: 2.5 },
  { src:'/assets/img/g9.jpg',    p:0.45, l:2, y:8,  w:344, h:482, r:-1.0 },
  { src:'/assets/img/dish-1.jpg',p:0.58, l:2, y:44, w:362, h:272, r: 2.0 },
  { src:'/assets/img/g6.jpg',    p:0.71, l:2, y:16, w:368, h:518, r:-2.5 },
  { src:'/assets/img/g10.jpg',   p:0.84, l:2, y:28, w:338, h:226, r: 1.0 },
  { src:'/assets/img/g15.jpg',   p:0.97, l:2, y:54, w:354, h:496, r:-1.5 },

  // Layer 3 — near: fast · dominant · cinematic
  { src:'/assets/img/chef-1.jpg',p:0.10, l:3, y:6,  w:456, h:640, r:-1.5 },
  { src:'/assets/img/g2.jpg',    p:0.23, l:3, y:46, w:498, h:332, r: 2.0 },
  { src:'/assets/img/chef-3.jpg',p:0.37, l:3, y:10, w:472, h:662, r:-2.5 },
  { src:'/assets/img/dish-2.jpg',p:0.50, l:3, y:50, w:516, h:344, r: 1.5 },
  { src:'/assets/img/g14.jpg',   p:0.63, l:3, y:14, w:460, h:646, r:-1.0 },
  { src:'/assets/img/g16.jpg',   p:0.76, l:3, y:5,  w:484, h:324, r: 3.0 },
  { src:'/assets/img/g17.jpg',   p:0.88, l:3, y:42, w:466, h:654, r:-2.0 },
  { src:'/assets/img/g18.jpg',   p:0.98, l:3, y:8,  w:504, h:336, r: 1.5 },
];
---

<section class="image-flow" id="imageFlow" aria-hidden="true">
  <div class="image-flow__scene">
    {cards.map(c => (
      <div
        class="image-flow__card"
        data-phase={c.p}
        data-layer={c.l}
        data-w={c.w}
        data-rot={c.r}
        style={`width:${c.w}px;height:${c.h}px;top:${c.y}%`}
      >
        <img src={c.src} alt="" loading="lazy" decoding="async" />
      </div>
    ))}
  </div>
</section>
