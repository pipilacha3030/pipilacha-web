---
/* ============================================================
   INTERLUDIO "35 flores" — el dato se hace literal.
   No hay número dibujado ni adorno: hay EXACTAMENTE 35 flores en pantalla,
   una por cada flor comestible de la temporada. Empiezan dispersas por toda
   la sección y el scroll las REÚNE en una guirnalda alrededor de la frase
   (interlude.js calcula el destino con la caja real del texto, así que la
   guirnalda se recompone sola al redimensionar). Al posarse la frase, una
   onda recorre el ramo; el cursor las aparta mientras lees.
   Sin JS / reduced-motion: campo de flores disperso y quieto, frase legible.
   ============================================================ */
const { lang = 'es' } = Astro.props;
const line = lang === 'en'
  ? 'Thirty-five edible flowers, a single season.'
  : 'Treinta y cinco flores comestibles, una sola temporada.';

const FLORES = ['cosmos', 'dalia', 'borraja', 'calendula', 'aciano', 'coreopsis', 'amapola', 'geranio', 'clavel'];
/* PRNG con semilla fija: la dispersión es "aleatoria" pero el HTML sale
   idéntico en cada build (nada de Math.random en tiempo de compilación). */
let s = 3535;
const rnd = () => ((s = (s * 1664525 + 1013904223) % 4294967296) / 4294967296);
const blooms = Array.from({ length: 35 }, (_, i) => ({
  src: FLORES[i % FLORES.length],
  x: +(3 + rnd() * 94).toFixed(2),   // dispersión de partida, % de la sección
  y: +(5 + rnd() * 90).toFixed(2),
  depth: i % 3,                      // 0 = al fondo (pequeña, difusa) · 2 = delante
  dur: +(9 + rnd() * 9).toFixed(1),  // deriva propia: ninguna respira igual
  delay: +(-rnd() * 12).toFixed(1),
  spin: +(rnd() * 26 - 13).toFixed(1),
}));
---

<section class="interlude">
  <div class="interlude__field" aria-hidden="true">
    {blooms.map((b) => (
      <span
        class={`ilf ilf--d${b.depth}`}
        style={`--x:${b.x}%;--y:${b.y}%;--dur:${b.dur}s;--delay:${b.delay}s;--spin:${b.spin}deg`}
      >
        <span class="ilf__push">
          <img src={`/assets/img/flor-${b.src}.png`} alt="" width="80" height="80" loading="lazy" decoding="async" />
        </span>
      </span>
    ))}
  </div>
  <p class="interlude__line">{line}</p>
</section>
