---
/* Navegación fija. `solidNav`: cream sobre fondo claro (todas las páginas
   menos el Inicio, que va transparente sobre el hero). El estado scrolled,
   el overlay de menú y el vuelo de la libélula viven en src/scripts/nav.js. */
const { solidNav = true, path = '/' } = Astro.props;
const here = (href) => path === href;
// `flower`: PNG que aparece en tiles al hover del enlace en el overlay (una flor por opción)
const menu = [
  { href: '/conocenos/', label: 'Conócenos', key: '/conocenos', flower: '/assets/img/flor-dahlia-rosa.png' },
  { href: '/menu/', label: 'Menú', key: '/menu', flower: '/assets/img/flor-hibiscus.png' },
  { href: '/vinos/', label: 'Vinos', key: '/vinos', flower: '/assets/img/flor-dahlia-roja.png' },
  { href: '/galeria/', label: 'Galería', key: '/galeria', flower: '/assets/img/flor-cosmos.png' },
  { href: '/prensa/', label: 'Prensa', key: '/prensa', flower: '/assets/img/flor-aciano.png' },
  { href: '/regala/', label: 'Regalar', key: '/regala', flower: '/assets/img/flor-amapola.png' },
];
---
<header class={`nav${solidNav ? ' nav--solid' : ''}`} id="nav">
  <a href="/" class="nav__logo" aria-label="Pipilacha inicio">
    <img src="/assets/img/logo-light.png" class="nav__logo-img nav__logo-img--light" alt="Pipilacha" width="560" height="216" />
    <img src="/assets/img/logo-dark.png" class="nav__logo-img nav__logo-img--dark" alt="" aria-hidden="true" width="560" height="216" />
    <img src="/assets/img/iso-light.png" class="nav__logo-iso" alt="Pipilacha" width="200" height="200" />
  </a>
  <div class="nav__right">
    <nav class="nav__links" id="navLinks">
      {menu.map((m) => (
        <a href={m.href} aria-current={here(m.key) ? 'page' : undefined}>{m.label}</a>
      ))}
      <a href="/reservas/" class="nav__cta">Reservar</a>
    </nav>
    <button class="nav__burger" id="burger" aria-label="Abrir menú" aria-controls="navOverlay" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
</header>

<!-- Overlay de menú a pantalla completa (estilo Osmo): lo abre el burger en
     cualquier tamaño; los enlaces suben tras una máscara en cascada. -->
<div class="nav-overlay" id="navOverlay" aria-hidden="true">
  <!-- tiles de imagen: al hover de una opción, su flor aparece repartida a la derecha -->
  <div class="nav-overlay__tiles" aria-hidden="true">
    <span class="nav-tile nav-tile--a"><img alt="" decoding="async" /></span>
    <span class="nav-tile nav-tile--b"><img alt="" decoding="async" /></span>
    <span class="nav-tile nav-tile--c"><img alt="" decoding="async" /></span>
  </div>
  <nav class="nav-overlay__list" aria-label="Menú principal">
    {menu.map((m) => (
      <a href={m.href} data-flower={m.flower} aria-current={here(m.key) ? 'page' : undefined}><span>{m.label}</span></a>
    ))}
    <a href="/reservas/" class="nav-overlay__cta" data-flower="/assets/img/flor-calendula.png"><span>Reservar</span></a>
  </nav>
  <div class="nav-overlay__foot">
    <a href="https://instagram.com/restaurante.pipilacha" target="_blank" rel="noopener">@restaurante.pipilacha</a>
    <a href="tel:+34919125998">919 12 59 98</a>
  </div>
</div>
