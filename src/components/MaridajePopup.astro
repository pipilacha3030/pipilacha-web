---
/* POP-UP DEL MARIDAJE — solo en la página de vinos. Tarjeta moss fija que
   ofrece «Copa a copa»; la muestra src/scripts/maridajePopup.js a los 5 s de
   llegar (una vez por sesión, y nunca encima del banner de cookies). Estilos
   en main.css (.mpop): la hoja global carga en todas las páginas, así el
   pop-up llega estilado también cuando se entra a /vinos/ por transición. */
const { lang = 'es' } = Astro.props;
const t = lang === 'en'
  ? {
      aria: 'Wine pairing', eyebrow: 'Wine pairing', title: 'Glass by glass',
      text: 'Six wines that follow the fifteen courses and evolve with the seasonal menu.',
      price: '+€60', cta: 'Book', href: '/en/reservas/', close: 'Close',
    }
  : {
      aria: 'Maridaje', eyebrow: 'Maridaje', title: 'Copa a copa',
      text: 'Seis vinos que acompañan los quince pases y evolucionan con el menú de temporada.',
      price: '+60 €', cta: 'Reservar', href: '/reservas/', close: 'Cerrar',
    };
---

<aside class="mpop" id="maridajePop" role="dialog" aria-label={t.aria} hidden>
  {/* eager: el pop-up está oculto hasta abrirse — con lazy la flor se descargaba
      al abrir y aparecía tarde */}
  <img class="mpop__flor" src="/assets/img/flor-borraja.png" alt="" width="60" height="60" loading="eager" fetchpriority="low" decoding="async" />
  <button class="mpop__close" type="button" aria-label={t.close}>&times;</button>
  <p class="mpop__eyebrow">{t.eyebrow}</p>
  <p class="mpop__title">{t.title}</p>
  <p class="mpop__text">{t.text}</p>
  <div class="mpop__row">
    <span class="mpop__price">{t.price}</span>
    <a href={t.href} class="mpop__cta">{t.cta}</a>
  </div>
</aside>
