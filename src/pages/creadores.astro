---
import Base from '../layouts/Base.astro';
import { flores, menuNombre } from '../data/menu.js';

/* Dossier privado que Arán y Noé pasan por DM a creadores antes de que vengan.
   Los pases y las flores salen de src/data/menu.js: al cambiar de carta, esta
   página se actualiza sola y no puede discrepar del menú real. */

// Los pases que mejor se cuentan en vídeo. El orden es el del menú.
const bleed = {
  higo: {
    n: '10', name: 'Higo a la brasa con helado de saúco',
    hook: 'El higo se marca a la brasa y llega negro. El saúco entra frío, floral y ligeramente vinoso. Te lo comes antes de que te expliquen qué es.',
    img: 'cr-higo', alt: 'Higo a la brasa con helado de saúco, servido en plato negro',
  },
  vieiras: {
    n: '11', name: 'Vieiras shiso-dalias',
    hook: 'El shiso pica en verde; el pétalo de dalia endulza el yodo de la vieira. Dos flores tirando en direcciones opuestas dentro del mismo plato.',
    img: 'cr-vieiras', alt: 'Vieiras con shiso y pétalos de dalia',
  },
};

const duoA = [
  { n: '06', name: 'Mojito entre borrajas', hook: 'La flor de borraja lleva menta y lima a un bocado que recuerda al mojito sin serlo. Llega con pinzas, flor a flor.', img: 'cr-mojito', alt: 'Mojito entre borrajas, con la flor colocada con pinzas' },
  { n: '08', name: 'Ajoblanco con capuchinas', hook: 'La capuchina pica como un rábano suave. Cae sobre el ajoblanco frío y lo despierta entero.', img: 'cr-ajoblanco', alt: 'Ajoblanco con capuchinas y hojas de capuchina' },
];

const duoB = [
  { n: '09', name: 'Fusión tomate-hinojo', hook: 'Tomate maduro y flor de hinojo cruzan el anís con el dulzor en el mismo bocado. Servido sobre piedra.', img: 'cr-tomate', alt: 'Fusión de tomate y flor de hinojo sobre piedra' },
  { n: '13', name: 'Codorniz y flores ácidas', hook: 'Las flores ácidas cortan la grasa de la codorniz sin que haga falta una gota de vinagre.', img: 'cr-codorniz', alt: 'Codorniz con flores ácidas sobre jugo reducido' },
];

// Campo tipográfico de las 32 flores: el tamaño varía de forma determinista
// (no aleatoria: si no, cada build cambiaría el HTML) para que lea a jardín
// y no a lista.
const escala = (i) => (i % 7 === 0 ? 'xl' : i % 3 === 0 ? 'lg' : i % 5 === 0 ? 'sm' : 'md');
---

<Base
  title="Pipilacha · Dossier para creadores"
  description="Lo que hay que saber antes de contar Pipilacha: los pases que se cuentan solos, las 32 flores de la carta y cómo se ve la casa."
  ogImage="/assets/img/cr-hero.jpg"
  noindex={true}
>

<!-- 1 · APERTURA A SANGRE — el plato más oscuro de la carta ocupa la pantalla
     entera. El titular entra con cortina; la foto lleva parallax. La página
     empieza dentro de un plato, no dentro de una portada. -->
<section class="cr-open">
  <div class="cr-open__media" data-parallax="0.12">
    <!-- dirección de arte: en móvil el recorte 0.46 ya viene hecho (cr-hero-m),
         si no el navegador recortaría el 4:5 a una tira vertical y la flor-cuenco
         dejaría de leerse -->
    <img src="/assets/img/cr-hero.jpg"
         srcset="/assets/img/cr-hero-m.jpg 900w, /assets/img/cr-hero.jpg 1800w"
         sizes="100vw" width="1800" height="2250"
         fetchpriority="high" decoding="async"
         alt="Farolillo de atún y orégano: el tartar servido dentro de la propia flor" />
    <span class="cr-open__veil" aria-hidden="true"></span>
  </div>
  <div class="cr-open__content">
    <p class="eyebrow reveal">Dossier para creadores</p>
    <h1 class="cr-open__title reveal-head">La flor no decora.<br>Es el plato.</h1>
    <p class="cr-open__sub reveal">Todo lo que necesitas saber antes de contarlo.</p>
    <p class="cr-open__credit reveal">Arriba · Pase 05, farolillo de atún y orégano. El cuenco es la flor.</p>
  </div>
</section>

<!-- 2 · MANIFIESTO — crema, texto solo. Después de la imagen a sangre, aire.
     Entra línea a línea (SplitText). -->
<section class="cr-manifesto">
  <div class="cr-manifesto__inner">
    <p class="cr-manifesto__p" data-split-lines>Pipilacha es la libélula: así la llaman en Centroamérica. El insecto que no para de volar, como una carta que se rehace entera cada estación.</p>
    <p class="cr-manifesto__p" data-split-lines>Cada plato se levanta sobre una flor. Su sabor, su textura, lo que hace al cocinarla. La capuchina pica como un rábano. La flor eléctrica duerme la lengua. El farolillo es ácido y sirve de cuenco.</p>
    <p class="cr-manifesto__p" data-split-lines>No es un restaurante con flores encima. Es el único construido entero sobre ellas.</p>
  </div>
</section>

<!-- 3 · CIFRAS — banda oscura, compacta y tabular. Corte de ritmo entre dos
     bloques grandes: aquí todo es pequeño y denso a propósito. -->
<section class="cr-cifras" data-reveal-stagger>
  <div class="cr-cifras__grid">
    <div class="cr-cifra reveal"><span class="cr-cifra__n">16</span><span class="cr-cifra__t">asientos por servicio</span></div>
    <div class="cr-cifra reveal"><span class="cr-cifra__n">15</span><span class="cr-cifra__t">pases</span></div>
    <div class="cr-cifra reveal"><span class="cr-cifra__n">{flores.length}</span><span class="cr-cifra__t">flores en la carta</span></div>
    <div class="cr-cifra reveal"><span class="cr-cifra__n">85<i>€</i></span><span class="cr-cifra__t">menú completo</span></div>
  </div>
</section>

<!-- 4 · LOS PASES — alterna plato a sangre (inmersión) con pares desalineados
     (respiro). La segunda pieza de cada par baja para romper la retícula: es lo
     que separa una composición editorial de una cuadrícula. -->
<section class="cr-pases">
  <header class="cr-pases__head">
    <p class="eyebrow reveal">Lo que vas a probar</p>
    <h2 class="cr-h2 reveal-head">{menuNombre}</h2>
    <p class="cr-pases__lede reveal">Quince pases. Estos seis se cuentan solos.</p>
  </header>
</section>

<figure class="cr-bleed">
  <div class="cr-bleed__media" data-parallax="0.10">
    <img src={`/assets/img/${bleed.higo.img}.jpg`}
         srcset="/assets/img/cr-higo-m.jpg 900w, /assets/img/cr-higo.jpg 1400w"
         sizes="100vw" width="1400" height="1750"
         loading="lazy" decoding="async" alt={bleed.higo.alt} />
    <span class="cr-bleed__veil" aria-hidden="true"></span>
  </div>
  <figcaption class="cr-bleed__copy reveal">
    <span class="cr-pase__n">Pase {bleed.higo.n}</span>
    <h3 class="cr-pase__name">{bleed.higo.name}</h3>
    <p class="cr-pase__hook">{bleed.higo.hook}</p>
  </figcaption>
</figure>

<section class="cr-duo">
  {duoA.map((p) => (
    <article class="cr-duo__item reveal">
      <div class="cr-duo__media">
        <img src={`/assets/img/${p.img}.jpg`} sizes="(min-width:760px) 50vw, 100vw" width="1600" height="2000" loading="lazy" decoding="async" alt={p.alt} />
      </div>
      <span class="cr-pase__n">Pase {p.n}</span>
      <h3 class="cr-pase__name">{p.name}</h3>
      <p class="cr-pase__hook">{p.hook}</p>
    </article>
  ))}
</section>

<figure class="cr-bleed cr-bleed--right">
  <div class="cr-bleed__media" data-parallax="0.10">
    <img src={`/assets/img/${bleed.vieiras.img}.jpg`}
         srcset="/assets/img/cr-vieiras-m.jpg 900w, /assets/img/cr-vieiras.jpg 1600w"
         sizes="100vw" width="1600" height="2000"
         loading="lazy" decoding="async" alt={bleed.vieiras.alt} />
    <span class="cr-bleed__veil" aria-hidden="true"></span>
  </div>
  <figcaption class="cr-bleed__copy reveal">
    <span class="cr-pase__n">Pase {bleed.vieiras.n}</span>
    <h3 class="cr-pase__name">{bleed.vieiras.name}</h3>
    <p class="cr-pase__hook">{bleed.vieiras.hook}</p>
  </figcaption>
</figure>

<section class="cr-duo">
  {duoB.map((p) => (
    <article class="cr-duo__item reveal">
      <div class="cr-duo__media">
        <img src={`/assets/img/${p.img}.jpg`} sizes="(min-width:760px) 50vw, 100vw" width="1600" height="2000" loading="lazy" decoding="async" alt={p.alt} />
      </div>
      <span class="cr-pase__n">Pase {p.n}</span>
      <h3 class="cr-pase__name">{p.name}</h3>
      <p class="cr-pase__hook">{p.hook}</p>
    </article>
  ))}
</section>

<!-- 5 · TEXTURA — banda de atmósfera pura: un detalle a sangre y una sola
     línea encima. Sirve de respiración entre los platos y los dos chefs. -->
<section class="cr-textura">
  <div class="cr-textura__media" data-parallax="0.14">
    <img src="/assets/img/cr-textura.jpg"
         srcset="/assets/img/cr-textura-m.jpg 900w, /assets/img/cr-textura.jpg 1800w"
         sizes="100vw" width="1800" height="2250" loading="lazy" decoding="async"
         alt="Pétalos de capuchina y hojas sobre crema de ajoblanco" />
    <span class="cr-textura__veil" aria-hidden="true"></span>
  </div>
  <p class="cr-textura__line reveal">Ninguna flor está ahí para la foto.<br>Todas se comen.</p>
</section>

<!-- 6 · LOS DOS — díptico. Retratos de julio de 2026 en la propia barra.
     Reacciona al hover/foco como el díptico de Conócenos. -->
<section class="cr-duo-chefs" aria-label="Arán y Noé, los dos fundadores">
  <header class="cr-duo-chefs__head">
    <p class="eyebrow reveal">Quiénes están detrás</p>
    <h2 class="cr-h2 cr-h2--dark reveal-head">Arán y Noé</h2>
    <p class="cr-duo-chefs__lede reveal">Se formaron en <b>Ramón Freixa, dos estrellas</b>. Montaron Pipilacha para investigar una sola cosa: qué puede hacer el sabor de una flor dentro de un plato. Dieciséis asientos son los que caben si quieres cocinar mirando a quien come.</p>
  </header>
  <div class="cr-duo-chefs__grid">
    <article class="cr-chef reveal" tabindex="0">
      <img src="/assets/img/cr-aran.jpg" width="1200" height="1600" loading="lazy" decoding="async" alt="Arán Rodrigo, cofundador y chef, en la barra de Pipilacha" />
      <div class="cr-chef__copy">
        <p class="cr-chef__name">Arán Rodrigo</p>
        <p class="cr-chef__line">Cofundador &amp; chef</p>
      </div>
    </article>
    <article class="cr-chef reveal" tabindex="0">
      <img src="/assets/img/cr-noe.jpg" width="1200" height="1600" loading="lazy" decoding="async" alt="Noé David, cofundador y chef, en la barra de Pipilacha" />
      <div class="cr-chef__copy">
        <p class="cr-chef__name">Noé David</p>
        <p class="cr-chef__line">Cofundador &amp; chef</p>
      </div>
    </article>
  </div>
</section>

<!-- 7 · EL CAMPO DE FLORES — las 32 de la carta como campo tipográfico de
     tamaños desiguales. Sale de src/data/menu.js: no puede desincronizarse. -->
<section class="cr-campo">
  <header class="cr-campo__head">
    <p class="eyebrow reveal">La carta, en flores</p>
    <h2 class="cr-h2 reveal-head">{flores.length} en un solo menú</h2>
  </header>
  <!-- el contenedor NO lleva .reveal: reveal.js salta todo lo que esté dentro de
       un [data-reveal-stagger] (closest() se incluye a sí mismo) y se quedaría
       en opacity:0 para siempre. Anima solo a los hijos. -->
  <ul class="cr-campo__list" data-reveal-stagger>
    {flores.map((f, i) => <li class={`cr-flor cr-flor--${escala(i)} reveal`}>{f}</li>)}
  </ul>
</section>

<!-- 8 · CÓMO CONTARLO — la parte útil. Denso y pequeño a propósito: contrasta
     con toda la imagen grande de arriba y se lee como una ficha de trabajo. -->
<section class="cr-guia">
  <header class="cr-guia__head">
    <p class="eyebrow reveal">Cómo contarlo</p>
    <h2 class="cr-h2 cr-h2--dark reveal-head">Para tu vídeo</h2>
  </header>

  <div class="cr-guia__cols">
    <div class="cr-guia__col reveal">
      <h3 class="cr-guia__h">Los tres ángulos</h3>
      <dl class="cr-guia__dl">
        <dt>El plato que no esperas</dt>
        <dd>Enseña la forma antes que el nombre. Un cuenco que es una flor. Un higo que te comes antes de que te expliquen qué es.</dd>
        <dt>Solo dieciséis</dt>
        <dd>Dos servicios, dieciséis asientos. Es de los sitios de los que se presume por haber entrado.</dd>
        <dt>Flores que saben</dt>
        <dd>Di a qué sabe cada una. Que la capuchina pique a rábano sorprende mucho más que decir «lleva flores».</dd>
      </dl>
    </div>

    <div class="cr-guia__col reveal">
      <h3 class="cr-guia__h">Frases que enganchan</h3>
      <ul class="cr-frases">
        <li>Aquí la flor no decora: es el plato.</li>
        <li>{flores.length} flores en un solo menú.</li>
        <li>La flor eléctrica te duerme la lengua.</li>
        <li>El cuenco era la flor. Me lo comí entero.</li>
        <li>Dieciséis asientos. Reservé con semanas.</li>
      </ul>

      <h3 class="cr-guia__h cr-guia__h--sep">Habla como la casa</h3>
      <ul class="cr-voz">
        <li><b>Di la flor y el plato.</b> «Ajoblanco con capuchinas» dice más que «cocina botánica».</li>
        <li><b>Cuenta lo que pasó en la mesa</b>, no «la experiencia».</li>
        <li><b>Nombra a Arán y Noé.</b> Es una casa de dos personas y se nota en cada pase.</li>
      </ul>
    </div>
  </div>

  <div class="cr-mirada reveal">
    <h3 class="cr-guia__h">Cómo se ve</h3>
    <ul class="cr-mirada__list">
      <li><b>Luz natural o tenue.</b> Nada de flash duro.</li>
      <li><b>Primer plano cenital.</b> Casi todo se emplata para verse desde arriba.</li>
      <li><b>Fondo de piedra o madera.</b> Deja respirar al plato.</li>
      <li><b>Sin filtros saturados.</b> El color ya está ahí.</li>
    </ul>
    <ul class="cr-paleta" aria-label="Paleta de la casa">
      <li><i style="background:#0D0D0D"></i><span>Obsidiana</span></li>
      <li><i style="background:#31331F"></i><span>Musgo</span></li>
      <li><i style="background:#645D3B"></i><span>Oliva</span></li>
      <li><i style="background:#D5CDBC"></i><span>Avena</span></li>
      <li><i style="background:#F4EFE6"></i><span>Crema</span></li>
    </ul>
  </div>
</section>

<!-- 9 · PRÁCTICO + CIERRE — ficha compacta y salida a sangre. -->
<section class="cr-practico">
  <dl class="cr-practico__dl" data-reveal-stagger>
    <div class="cr-row reveal"><dt>Dónde</dt><dd>C. del Azulejo, 2<span>Fuente del Berro, Madrid</span></dd></div>
    <div class="cr-row reveal"><dt>Cuándo</dt><dd>Jueves a domingo<span>Dos servicios · 14:00 y 21:00</span></dd></div>
    <div class="cr-row reveal"><dt>Formato</dt><dd>15 pases · 85 €<span>Maridaje, +60 €</span></dd></div>
    <div class="cr-row reveal"><dt>Aforo</dt><dd>16 por servicio<span>Barra, una mesa de cuatro y dos de dos</span></dd></div>
    <div class="cr-row reveal"><dt>Escríbenos</dt><dd><a href="https://instagram.com/restaurante.pipilacha" target="_blank" rel="noopener">@restaurante.pipilacha</a><span>Cuéntanos qué quieres grabar y te cuadramos el servicio</span></dd></div>
  </dl>
</section>

<section class="cr-cierre">
  <p class="cr-cierre__big reveal-head">Antes de entrar,<br>ya sabes de qué va.</p>
  <p class="cr-cierre__sub reveal">Ahora ven a probarlo.</p>
</section>

<style>
  /* ============================================================
     DOSSIER CREADORES · composición editorial
     Reglas que la sostienen:
     · contraste de escala — un titular enorme, pies de foto diminutos
     · alternancia sangre / columna estrecha — inmersión y respiro
     · asimetría — la segunda pieza de cada par baja, nunca se alinea
     · densidad por bloques — imagen grande junto a ficha densa
     Reutiliza el sistema del sitio: .reveal, .reveal-head, data-split-lines,
     data-parallax, .eyebrow. Nada de animación propia.
     ============================================================ */

  .cr-h2{font-family:var(--serif);font-weight:400;line-height:1.02;letter-spacing:-.015em;
         font-size:clamp(2.2rem,6.5vw,4.6rem);color:var(--cloud)}
  .cr-h2--dark{color:var(--ink)}

  /* pies de pase: diminutos frente al titular — el contraste de escala es
     lo que hace que la foto mande */
  .cr-pase__n{display:block;font-size:.68rem;letter-spacing:.28em;text-transform:uppercase;
              color:var(--accent-soft);margin-bottom:.75rem}
  .cr-pase__name{font-family:var(--serif);font-weight:400;line-height:1.08;
                 font-size:clamp(1.45rem,3.2vw,2.1rem);color:var(--cloud);margin-bottom:.6rem}
  .cr-pase__hook{color:rgba(244,239,230,.72);font-size:1rem;line-height:1.6;max-width:34ch}

  /* ---------- 1 · apertura a sangre ---------- */
  .cr-open{position:relative;min-height:100svh;display:flex;align-items:flex-end;
           overflow:clip;background:#0D0D0D}
  .cr-open__media{position:absolute;inset:-8% 0;z-index:0}
  .cr-open__media img{width:100%;height:100%;object-fit:cover;object-position:50% 46%}
  /* el velo solo oscurece donde hay letra: arriba lo justo para la nav, abajo
     una rampa que muere en el fondo de la sección. En medio, la foto limpia. */
  /* la portada es una foto CLARA (cuenco blanco, piedra pálida) y el texto va en
     crema: la rampa de abajo tiene que ser franca o el titular no se lee */
  .cr-open__veil{position:absolute;inset:0;
    background:linear-gradient(180deg,rgba(13,13,13,.5) 0%,rgba(13,13,13,.1) 22%,
               rgba(13,13,13,0) 38%,rgba(13,13,13,.38) 56%,rgba(13,13,13,.74) 72%,
               rgba(13,13,13,.94) 88%,#0D0D0D 100%)}
  .cr-open__content{position:relative;z-index:1;width:100%;
                    padding:0 var(--gutter) clamp(2.6rem,6vh,4.5rem)}
  .cr-open__content .eyebrow{color:var(--accent-soft)}
  .cr-open__title{font-family:var(--serif);font-weight:400;color:var(--cloud);
    font-size:clamp(2.5rem,7.6vw,6.4rem);line-height:.96;letter-spacing:-.03em;
    margin:.3em 0 .38em;text-shadow:0 2px 40px rgba(0,0,0,.45)}
  .cr-open__sub{color:var(--cloud);font-size:clamp(1rem,2vw,1.2rem);max-width:30ch}
  .cr-open__credit{margin-top:1.5rem;font-size:.7rem;letter-spacing:.17em;
                   text-transform:uppercase;color:var(--accent-soft);opacity:.85}

  /* ---------- 2 · manifiesto ---------- */
  .cr-manifesto{background:var(--cream);color:var(--ink);
                padding:clamp(5rem,15vh,11rem) var(--gutter)}
  .cr-manifesto__inner{max-width:60ch;margin:0 auto;display:grid;gap:1.6em}
  .cr-manifesto__p{font-family:var(--serif);font-weight:400;
    font-size:clamp(1.35rem,3.4vw,2.15rem);line-height:1.32;letter-spacing:-.01em}
  .cr-manifesto__p:last-child{color:var(--olive)}

  /* ---------- 3 · cifras ---------- */
  .cr-cifras{background:var(--moss);padding:clamp(2.6rem,6vh,4rem) var(--gutter)}
  .cr-cifras__grid{max-width:var(--maxw);margin:0 auto;display:grid;gap:2rem 1.5rem;
                   grid-template-columns:repeat(2,1fr)}
  .cr-cifra{display:flex;flex-direction:column;gap:.35rem}
  .cr-cifra__n{font-family:var(--serif);font-size:clamp(2.4rem,7vw,3.6rem);line-height:.9;
               color:var(--cloud);font-variant-numeric:tabular-nums}
  .cr-cifra__n i{font-style:normal;font-size:.42em;color:var(--accent-soft);margin-left:.08em}
  .cr-cifra__t{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;
               color:rgba(244,239,230,.6);line-height:1.4}

  /* ---------- 4 · pases ---------- */
  .cr-pases{background:#0D0D0D;padding:clamp(4.5rem,12vh,8rem) var(--gutter) clamp(2.5rem,6vh,4rem)}
  .cr-pases__head{max-width:var(--maxw);margin:0 auto}
  .cr-pases__head .eyebrow{color:var(--accent-soft)}
  .cr-pases__lede{margin-top:1.1rem;color:rgba(244,239,230,.66);
                  font-size:clamp(1rem,2.2vw,1.22rem);max-width:36ch}

  /* plato a sangre: la foto ocupa el ancho entero y el pie se apoya encima */
  .cr-bleed{position:relative;min-height:86svh;display:flex;align-items:flex-end;
            overflow:clip;background:#0D0D0D;margin:0}
  .cr-bleed__media{position:absolute;inset:-7% 0;z-index:0}
  .cr-bleed__media img{width:100%;height:100%;object-fit:cover}
  /* la rampa tiene que empezar por encima del pie: hay platos claros (vieiras,
     tomate) donde el titular en crema se perdía sobre la piedra pálida */
  .cr-bleed__veil{position:absolute;inset:0;
    background:linear-gradient(180deg,#0D0D0D 0%,rgba(13,13,13,.4) 10%,rgba(13,13,13,0) 30%,
               rgba(13,13,13,.34) 50%,rgba(13,13,13,.72) 68%,rgba(13,13,13,.93) 86%,#0D0D0D 100%)}
  .cr-bleed .cr-pase__name,.cr-bleed .cr-pase__hook{text-shadow:0 1px 24px rgba(0,0,0,.55)}
  .cr-bleed__copy{position:relative;z-index:1;width:100%;
                  padding:0 var(--gutter) clamp(2.8rem,7vh,5rem)}

  /* par desalineado: la segunda pieza baja. Esto es lo que rompe la retícula */
  .cr-duo{background:#0D0D0D;padding:clamp(3rem,8vh,6rem) var(--gutter);
          display:grid;gap:clamp(2.5rem,6vw,4rem);grid-template-columns:1fr;
          max-width:var(--maxw);margin:0 auto}
  .cr-duo__media{aspect-ratio:4/5;overflow:hidden;margin-bottom:1.4rem;
                 background:#16160f;border-radius:2px}
