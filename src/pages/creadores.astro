          border-top:1px solid rgba(100,93,59,.32)}
  .cr-row:first-child{border-top:none}
  .cr-row dt{font-size:.68rem;letter-spacing:.24em;text-transform:uppercase;color:var(--accent-soft)}
  .cr-row dd{margin:0;font-family:var(--serif);font-size:clamp(1.15rem,3vw,1.5rem);
             color:var(--cloud);line-height:1.25}
  .cr-row dd span{display:block;font-family:var(--sans);font-size:.86rem;
                  color:rgba(244,239,230,.6);margin-top:.35rem;letter-spacing:0}
  .cr-row a{color:inherit;text-decoration:none;border-bottom:1px solid var(--olive)}

  .cr-cierre{background:#0D0D0D;padding:clamp(5rem,16vh,11rem) var(--gutter);
             display:grid;gap:1.2rem}
  .cr-cierre__big{font-family:var(--serif);font-weight:400;color:var(--cloud);
    font-size:clamp(2.1rem,7.5vw,5.5rem);line-height:1;letter-spacing:-.02em}
  .cr-cierre__sub{color:var(--accent-soft);font-size:clamp(1rem,2.2vw,1.35rem)}

  /* ---------- composición en pantallas grandes ---------- */
  @media (min-width:760px){
    .cr-cifras__grid{grid-template-columns:repeat(4,1fr)}
    .cr-duo{grid-template-columns:1fr 1fr;align-items:start}
    /* la asimetría: la segunda pieza cae fuera de línea */
    .cr-duo__item:nth-child(2){margin-top:clamp(3rem,10vh,8rem)}
    .cr-duo-chefs__grid{grid-template-columns:1fr 1fr;gap:1.6rem}
    .cr-guia__cols{grid-template-columns:1fr 1fr;gap:4rem}
    .cr-mirada{grid-template-columns:1.3fr 1fr;gap:3rem;align-items:start}
    .cr-row{grid-template-columns:minmax(150px,20%) 1fr;gap:1.5rem;align-items:baseline}
    .cr-bleed__copy,.cr-open__content{max-width:var(--maxw);margin:0 auto}
    /* el pie del segundo plato a sangre se va a la derecha: la página no
       repite el mismo eje dos veces */
    .cr-bleed--right .cr-bleed__copy{display:flex;justify-content:flex-end}
    .cr-bleed--right .cr-bleed__copy > *{max-width:38ch}
    .cr-bleed--right .cr-bleed__copy{flex-direction:column;align-items:flex-end;text-align:right}
    .cr-bleed--right .cr-pase__hook{margin-left:auto}
  }

  @media (prefers-reduced-motion:reduce){
