  .cr-voz b{color:var(--ink);font-weight:600}

  .cr-mirada{max-width:var(--maxw);margin:3.5rem auto 0;padding-top:2.5rem;
             border-top:1px solid var(--border-subtle);
             display:grid;gap:2.2rem;grid-template-columns:1fr}
