---
import Garden from '../layouts/Garden.astro';
import { flores, menuNombre } from '../data/menu.js';
import {
  escenas, manifiesto, vision, filosofia, angulos, historias,
  camara, movimiento, paleta, tipografia, materiales, detalles,
  ideas, hooks, captions, voz, material, contacto,
} from '../data/creatorGarden.js';

/* Los pases y las flores salen de src/data/menu.js. Al cambiar de carta
   esta página se actualiza sola: no hay ni un nombre de plato escrito
   a mano aquí dentro. */
const pases = {
  farolillo: { n: '05', t: 'Farolillo de atún y orégano', img: 'cr-farolillo',
    d: 'La flor hace de recipiente y suelta un ácido que corta la grasa del atún. Te comes el cuenco.',
    alt: 'Farolillo de atún y orégano servido dentro de la propia flor' },
  higo: { n: '10', t: 'Higo a la brasa con helado de saúco', img: 'cr-higo',
    d: 'El higo llega negro de la brasa. El saúco entra frío, floral y ligeramente vinoso.',
    alt: 'Higo a la brasa con helado de saúco en plato negro' },
  vieiras: { n: '11', t: 'Vieiras shiso-dalias', img: 'cr-vieiras',
    d: 'El shiso pica en verde; el pétalo de dalia endulza el yodo. Dos flores tirando en direcciones opuestas.',
    alt: 'Vieiras con shiso y pétalos de dalia' },
};
---

<Garden>

{/* tallo: hilo continuo que cose las escenas, atado al progreso real */}
<div class="gd-spine" aria-hidden="true">
  <svg viewBox="0 0 2 100" preserveAspectRatio="none">
    <path class="gd-spine__path" d="M1 0 L1 100" />
  </svg>
</div>

{/* índice: en una página larga saber dónde estás es función, no adorno */}
<nav class="gd-index" aria-label="Escenas">
  {escenas.map((e) => (
    <a class="gd-index__link" href={`#${e.id}`}>
      <span class="gd-index__label">{e.t}</span>
      <span class="gd-index__dot" aria-hidden="true"></span>
      <span class="sr-only">{e.t}</span>
    </a>
  ))}
</nav>

<main>

{/* ─── 00 · APERTURA ─────────────────────────────────────────── */}
<section class="gd-open" id="apertura">
  <div class="gd-open__media" data-gd-parallax="0.12">
    <img src="/assets/img/cr-hero.jpg"
         srcset="/assets/img/cr-hero-m.jpg 900w, /assets/img/cr-hero.jpg 1800w"
         sizes="100vw" width="1800" height="2250"
         fetchpriority="high" decoding="async"
         alt="Farolillo de atún y orégano: el tartar servido dentro de la propia flor" />
    <span class="gd-open__veil" aria-hidden="true"></span>
  </div>
  <div class="gd-open__inner">
    <p class="gd-eyebrow gd-reveal">Creator Garden</p>
    <h1 class="gd-display gd-open__title" data-gd-words>La flor no decora. Es el plato.</h1>
    <p class="gd-lede gd-open__sub gd-reveal">Para quien va a contarlo antes de haberlo probado.</p>
    <p class="gd-open__credit gd-reveal">Pase 05 · Farolillo de atún y orégano. El cuenco es la flor.</p>
  </div>
</section>

{/* ─── 01 · MANIFIESTO ───────────────────────────────────────── */}
<section class="gd-scene" id="manifiesto">
  <div class="gd-wrap gd-grid">
    <div class="gd-manifiesto">
      {manifiesto.map((p) => <p data-gd-lines>{p}</p>)}
    </div>
  </div>
</section>

{/* ─── 02 · LA VISIÓN ────────────────────────────────────────── */}
<section class="gd-scene gd-scene--cream" id="vision">
  <div class="gd-wrap gd-grid">
    <div class="gd-vision__head">
      <p class="gd-eyebrow gd-reveal">{vision.eyebrow}</p>
      <h2 class="gd-h1" data-gd-words style="margin-top:1.2rem">{vision.titulo}</h2>
    </div>
    <div class="gd-vision__cuerpo">
      {vision.cuerpo.map((p) => <p class="gd-body gd-reveal">{p}</p>)}
    </div>
    <div class="gd-vision__dato gd-dato gd-reveal">
      <span class="gd-dato__n">{vision.dato.n}</span>
      <span class="gd-dato__t">{vision.dato.t}</span>
      <p class="gd-dato__pie">{vision.dato.pie}</p>
    </div>
  </div>
</section>

{/* ─── plato a sangre · farolillo ─────────────────────────────── */}
<figure class="gd-bleed">
  <div class="gd-bleed__media" data-gd-parallax="0.1">
    <img src={`/assets/img/${pases.farolillo.img}.jpg`} width="1600" height="2000"
         loading="lazy" decoding="async" alt={pases.farolillo.alt} />
    <span class="gd-bleed__veil" aria-hidden="true"></span>
  </div>
  <figcaption class="gd-bleed__copy gd-reveal">
    <p class="gd-num">Pase {pases.farolillo.n}</p>
    <h2 class="gd-h2" style="margin:.5rem 0 .7rem">{pases.farolillo.t}</h2>
    <p class="gd-body">{pases.farolillo.d}</p>
  </figcaption>
</figure>

{/* ─── 03 · FILOSOFÍA ────────────────────────────────────────── */}
<section class="gd-scene" id="filosofia">
  <div class="gd-wrap gd-grid">
    <div class="gd-head">
      <p class="gd-eyebrow gd-reveal">Filosofía</p>
      <h2 class="gd-h1" data-gd-words style="margin-top:1.2rem">Cómo se piensa un plato</h2>
    </div>
    <div class="gd-cuerpo gd-list" data-gd-stagger>
      {filosofia.map((f) => (
        <article class="gd-list__item gd-item">
          <span class="gd-list__n">{f.n}</span>
          <h3 class="gd-list__t">{f.t}</h3>
          <p class="gd-list__d">{f.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

{/* ─── 04 · GUÍA ─────────────────────────────────────────────── */}
<section class="gd-scene gd-scene--moss" id="guia">
  <div class="gd-wrap gd-grid">
    <div class="gd-head">
      <p class="gd-eyebrow gd-reveal">Guía</p>
      <h2 class="gd-h1" data-gd-words style="margin-top:1.2rem">Los tres ángulos que funcionan</h2>
    </div>
    <div class="gd-cuerpo gd-list" data-gd-stagger>
      {angulos.map((a) => (
        <article class="gd-list__item gd-item">
          <span class="gd-list__n">{a.n}</span>
          <h3 class="gd-list__t">{a.t}</h3>
          <p class="gd-list__d">{a.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

{/* ─── 05 · HISTORIAS ────────────────────────────────────────── */}
<section class="gd-scene" id="historias">
  <div class="gd-wrap">
    <header style="margin-bottom:clamp(2.5rem,7vh,5rem)">
      <p class="gd-eyebrow gd-reveal">Historias</p>
      <h2 class="gd-h1" data-gd-words style="margin-top:1.2rem">Lo que hay que mirar</h2>
      <p class="gd-lede gd-reveal" style="margin-top:1.4rem">Seis cosas que pasan en el servicio y casi nadie graba.</p>
    </header>
    <div class="gd-cards gd-cards--desfase" data-gd-stagger>
      {historias.map((h) => (
        <article class="gd-card gd-item">
          <h3 class="gd-card__t">{h.t}</h3>
          <p class="gd-card__d">{h.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

{/* ─── plato a sangre · higo ──────────────────────────────────── */}
<figure class="gd-bleed">
  <div class="gd-bleed__media" data-gd-parallax="0.1">
    <img src={`/assets/img/${pases.higo.img}.jpg`}
         srcset="/assets/img/cr-higo-m.jpg 900w, /assets/img/cr-higo.jpg 1400w"
         sizes="100vw" width="1400" height="1750"
         loading="lazy" decoding="async" alt={pases.higo.alt} />
    <span class="gd-bleed__veil" aria-hidden="true"></span>
  </div>
  <figcaption class="gd-bleed__copy gd-reveal">
    <p class="gd-num">Pase {pases.higo.n}</p>
    <h2 class="gd-h2" style="margin:.5rem 0 .7rem">{pases.higo.t}</h2>
    <p class="gd-body">{pases.higo.d}</p>
  </figcaption>
</figure>

{/* ─── 06 · CÁMARA ───────────────────────────────────────────── */}
<section class="gd-scene gd-scene--cream" id="camara">
  <div class="gd-wrap">
    <header style="margin-bottom:clamp(2.5rem,7vh,5rem)">
      <p class="gd-eyebrow gd-reveal">Cámara</p>
      <h2 class="gd-h1" data-gd-words style="margin-top:1.2rem">Cómo se fotografía esta cocina</h2>
    </header>
    <div class="gd-camara">
      <div class="gd-reveal">
        <h3 class="gd-camara__h" style="color:var(--accent);border-color:var(--gd-hair-dark)">Foto</h3>
        <div class="gd-camara__list">
          {camara.foto.map((c) => (
            <div>
              <p class="gd-camara__t" style="color:var(--ink)">{c.t}</p>
              <p class="gd-camara__d" style="color:var(--text-muted)">{c.d}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="gd-reveal">
        <h3 class="gd-camara__h" style="color:var(--accent);border-color:var(--gd-hair-dark)">Vídeo</h3>
        <div class="gd-camara__list">
          {camara.video.map((c) => (
            <div>
              <p class="gd-camara__t" style="color:var(--ink)">{c.t}</p>
              <p class="gd-camara__d" style="color:var(--text-muted)">{c.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

{/* ─── 07 · MOVIMIENTO ───────────────────────────────────────── */}
<section class="gd-scene" id="movimiento">
  <div class="gd-wrap gd-grid">
    <div class="gd-head">
      <p class="gd-eyebrow gd-reveal">Movimiento</p>
      <h2 class="gd-h1" data-gd-words style="margin-top:1.2rem">Cómo se mueve la marca</h2>
      <p class="gd-body gd-reveal" style="margin-top:1.4rem">Las mismas reglas que rigen esta página. Sirven igual para un montaje.</p>
    </div>
    <div class="gd-cuerpo gd-list" data-gd-stagger>
      {movimiento.map((m, i) => (
        <article class="gd-list__item gd-item">
          <span class="gd-list__n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="gd-list__t">{m.t}</h3>
          <p class="gd-list__d">{m.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

{/* ─── 08 · IDENTIDAD ────────────────────────────────────────── */}
<section class="gd-scene" id="identidad">
  <div class="gd-wrap">
    <header style="margin-bottom:clamp(2.5rem,7vh,5rem)">
      <p class="gd-eyebrow gd-reveal">Identidad</p>
      <h2 class="gd-h1" data-gd-words style="margin-top:1.2rem">Tipografía, color, materia</h2>
    </header>

    <div class="gd-tipo gd-reveal" style="margin-bottom:clamp(3rem,8vh,6rem)">
      {tipografia.map((t, i) => (
        <div>
          <p class={`gd-tipo__muestra${i === 1 ? ' gd-tipo__muestra--sans' : ''}`}>
            Treinta y dos flores
          </p>
          <div class="gd-tipo__meta">
            <span class="gd-tipo__fam">{t.fam}</span>
            <span class="gd-tipo__rol">{t.rol}</span>
          </div>
          <p class="gd-card__d" style="margin-top:.6rem;max-width:44ch">{t.d}</p>
        </div>
      ))}
    </div>

    <div class="gd-paleta gd-reveal" style="margin-bottom:clamp(3rem,8vh,6rem)">
      {paleta.map((c) => (
        <div class="gd-swatch">
          <span class="gd-swatch__chip" style={`background:${c.hex}`}></span>
          <span class="gd-swatch__n">{c.n}</span>
          <span class="gd-swatch__hex">{c.hex}</span>
          <span class="gd-swatch__u">{c.u}</span>
        </div>
      ))}
    </div>

    <div class="gd-cards" data-gd-stagger>
      {materiales.map((m) => (
        <article class="gd-card gd-item">
          <h3 class="gd-card__t">{m.t}</h3>
          <p class="gd-card__d">{m.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

{/* ─── plato a sangre · vieiras ───────────────────────────────── */}
<figure class="gd-bleed">
  <div class="gd-bleed__media" data-gd-parallax="0.1">
    <img src={`/assets/img/${pases.vieiras.img}.jpg`}
         srcset="/assets/img/cr-vieiras-m.jpg 900w, /assets/img/cr-vieiras.jpg 1600w"
         sizes="100vw" width="1600" height="2000"
         loading="lazy" decoding="async" alt={pases.vieiras.alt} />
    <span class="gd-bleed__veil" aria-hidden="true"></span>
  </div>
  <figcaption class="gd-bleed__copy gd-reveal">
    <p class="gd-num">Pase {pases.vieiras.n}</p>
    <h2 class="gd-h2" style="margin:.5rem 0 .7rem">{pases.vieiras.t}</h2>
    <p class="gd-body">{pases.vieiras.d}</p>
  </figcaption>
</figure>

{/* ─── 09 · DETALLES ─────────────────────────────────────────── */}
<section class="gd-scene" id="detalles">
  <div class="gd-wrap">
    <header style="margin-bottom:clamp(2.5rem,7vh,5rem)">
      <p class="gd-eyebrow gd-reveal">Detalles</p>
      <h2 class="gd-h1" data-gd-words style="margin-top:1.2rem">Lo que se recuerda</h2>
    </header>
    <div class="gd-cards gd-cards--desfase" data-gd-stagger>
      {detalles.map((d) => (
        <article class="gd-card gd-item">
          <h3 class="gd-card__t">{d.t}</h3>
          <p class="gd-card__d">{d.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

{/* ─── el campo · las flores de la carta ──────────────────────── */}
<section class="gd-scene gd-scene--moss">
  <div class="gd-wrap">
    <header style="margin-bottom:clamp(2rem,5vh,3.5rem)">
      <p class="gd-eyebrow gd-reveal">{menuNombre}</p>
      <h2 class="gd-h1" data-gd-words style="margin-top:1.2rem">{flores.length} flores en un solo menú</h2>
    </header>
    <ul class="gd-campo" data-gd-stagger>
      {flores.map((f, i) => (
        <li class={`gd-flor gd-item gd-flor--${i % 7 === 0 ? 'xl' : i % 3 === 0 ? 'lg' : i % 5 === 0 ? 'sm' : 'md'}`}>{f}</li>
      ))}
    </ul>
  </div>
</section>

{/* ─── 10 · IDEAS ────────────────────────────────────────────── */}
<section class="gd-scene gd-scene--cream" id="ideas">
  <div class="gd-wrap">
    <header style="margin-bottom:clamp(2.5rem,7vh,5rem)">
      <p class="gd-eyebrow gd-reveal">Ideas</p>
      <h2 class="gd-h1" data-gd-words style="margin-top:1.2rem">Seis piezas que ya funcionan</h2>
      <p class="gd-lede gd-reveal" style="margin-top:1.4rem">Formato, idea y por qué engancha. Cógelas y hazlas tuyas.</p>
    </header>
    <div class="gd-cards gd-cards--tres" data-gd-stagger>
      {ideas.map((i) => (
        <article class="gd-card gd-item">
          <span class="gd-card__f">{i.f}</span>
          <h3 class="gd-card__t">{i.t}</h3>
          <p class="gd-card__d">{i.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

{/* ─── 11 · LENGUAJE ─────────────────────────────────────────── */}
<section class="gd-scene gd-scene--cream gd-scene--tight" id="lenguaje">
  <div class="gd-wrap">
    <header style="margin-bottom:clamp(2.5rem,7vh,4rem)">
      <p class="gd-eyebrow gd-reveal">Lenguaje</p>
      <h2 class="gd-h1" data-gd-words style="margin-top:1.2rem">Ganchos y pies</h2>
    </header>
    <div class="gd-grid">
      <div class="gd-lenguaje__hooks">
        <div class="gd-hooks" data-gd-stagger>
          {hooks.map((h, i) => (
            <p class="gd-hook gd-item">
              <span class="gd-hook__i">{String(i + 1).padStart(2, '0')}</span>{h}
            </p>
          ))}
        </div>
        <div style="margin-top:clamp(2.5rem,6vh,4rem)" data-gd-stagger>
          {voz.map((v) => (
            <div class="gd-item" style="margin-bottom:1.2rem">
              <p class="gd-camara__t" style="color:var(--ink)">{v.t}</p>
              <p class="gd-camara__d" style="color:var(--text-muted)">{v.d}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="gd-lenguaje__caps">
        {captions.map((c) => (
          <div class="gd-caption gd-reveal">
            <p class="gd-caption__t">{c.t}</p>
            <p class="gd-caption__d">{c.d}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

{/* ─── 12 · MATERIAL ─────────────────────────────────────────── */}
<section class="gd-scene" id="material">
  <div class="gd-wrap gd-grid">
    <div class="gd-head">
      <p class="gd-eyebrow gd-reveal">Material</p>
      <h2 class="gd-h1" data-gd-words style="margin-top:1.2rem">Para descargar</h2>
    </div>
    <div class="gd-cuerpo gd-mat" data-gd-stagger>
      {material.map((m) => (
        <a class="gd-mat__row gd-item" href={m.href} target="_blank" rel="noopener">
          <span>
            <span class="gd-mat__t">{m.t}</span>
            <span class="gd-mat__d">{m.d}</span>
          </span>
          <span class="gd-mat__meta">{m.meta}</span>
        </a>
      ))}
    </div>
  </div>
</section>

{/* ─── 13 · CONTACTO ─────────────────────────────────────────── */}
<section class="gd-scene" id="contacto">
  <div class="gd-wrap gd-grid">
    <div class="gd-contacto__head">
      <p class="gd-eyebrow gd-reveal">Contacto</p>
      <h2 class="gd-h1" data-gd-words style="margin:1.2rem 0 2rem">Cuéntanos qué quieres grabar</h2>
      <a class="gd-contacto__mail gd-reveal" href={`mailto:${contacto.email}`}>{contacto.email}</a>
      <p class="gd-body gd-reveal" style="margin-top:1.6rem">
        Escríbenos por aquí o por DM a <a href={`https://instagram.com/${contacto.ig}`} target="_blank" rel="noopener" style="color:var(--accent-soft)">@{contacto.ig}</a>. Cuadramos el servicio para que puedas grabar sin prisa.
      </p>
    </div>
    <div class="gd-contacto__datos gd-datos" data-gd-stagger>
      <div class="gd-datos__row gd-item"><span class="gd-datos__k">Dónde</span><span class="gd-datos__v">{contacto.dir}<br /><span style="font-family:var(--sans);font-size:.86rem;color:var(--gd-dim)">{contacto.zona}</span></span></div>
      <div class="gd-datos__row gd-item"><span class="gd-datos__k">Cuándo</span><span class="gd-datos__v">{contacto.horario}</span></div>
      <div class="gd-datos__row gd-item"><span class="gd-datos__k">Formato</span><span class="gd-datos__v">{contacto.formato}</span></div>
      <div class="gd-datos__row gd-item"><span class="gd-datos__k">Teléfono</span><span class="gd-datos__v"><a href={`tel:${contacto.tel}`}>{contacto.telLabel}</a></span></div>
    </div>
  </div>
</section>

{/* ─── CIERRE ────────────────────────────────────────────────── */}
<section class="gd-scene gd-cierre">
  <div>
    <h2 class="gd-h1 gd-cierre__big" data-gd-words>Abre la cámara antes de venir.</h2>
    <p class="gd-cierre__mark gd-reveal">Pipilacha</p>
  </div>
</section>

</main>
</Garden>

<style>
  /* el campo de flores: tamaños desiguales para que lea a jardín y no a lista */
  .gd-campo {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; align-items: baseline;
    gap: .2em .8em; font-family: var(--serif);
    color: rgba(244, 239, 230, .5);
  }
  .gd-flor { line-height: 1.25; transition: color .45s var(--ease); }
  .gd-flor--sm { font-size: clamp(.95rem, 2vw, 1.25rem); }
  .gd-flor--md { font-size: clamp(1.15rem, 2.8vw, 1.75rem); }
  .gd-flor--lg { font-size: clamp(1.4rem, 3.8vw, 2.5rem); color: rgba(244, 239, 230, .82); }
  .gd-flor--xl { font-size: clamp(1.7rem, 5vw, 3.4rem); color: var(--cloud); }
  @media (hover: hover) and (pointer: fine) {
    .gd-flor:hover { color: var(--accent-soft); }
  }
</style>
