---
import Garden from '../layouts/Garden.astro';
import { floresSabor, menuNombre } from '../data/menu.js';
import {
  saltos, apertura, casa, mesa, flores, ideas, frases, practico, cierre, contacto,
} from '../data/creatorGarden.js';

/* Las flores y su sabor salen de src/data/menu.js: al cambiar de carta esta
   página se actualiza sola. Aquí dentro no hay ni un sabor escrito a mano.

   Orden: primero qué es la casa (que es lo que hay que entender rápido),
   después qué pasa en la mesa, y al final el material suelto por si sirve.

   Nada va en imperativo. El creador viene invitado y sin nada pactado a
   cambio, así que la página ofrece, no manda. */
const figuras = {
  bosque: { img: 'cr-bosque', n: '03', t: 'Taco de tila y alisos',
    d: 'El aliso huele a miel y sabe a mostaza. Va sobre una masa hecha con harina de flor de tilo.',
    alt: 'Taco de tila y amapola sobre un soporte de mármol colgado de una rama' },
  retiro: { img: 'cr-retiro', t: 'Arán y Noé',
    d: 'La carta se rehace entera cada estación, y las flores salen de buscarlas.',
    alt: 'Arán y Noé bajo un árbol del amor en flor' },
};

// tira corta: tres pases del Solsticio, para ver de qué se habla
const tira = [
  { img: 'cr-cuchara',  alt: 'Flor de melocotón anisada con pétalos de geranio en una cuchara de madera', pie: 'Pase 04 · flor de melocotón y geranio' },
  { img: 'cr-borrajas', alt: 'Flores de borraja colocadas con pinza sobre granizado de lima', pie: 'Pase 06 · mojito entre borrajas' },
  { img: 'cr-vieiras',  alt: 'Vieiras en salsa clara con flores blancas y aceite de shiso', pie: 'Pase 11 · vieiras shiso-dalias' },
];

const dmUrl = `https://ig.me/m/${contacto.ig}`;
---

<Garden>

{/* Navegación fija, y presente EN MÓVIL: es donde se lee esta página. */}
<nav class="gd-nav" aria-label="Secciones">
  <ul class="gd-nav__list">
    {saltos.map((s) => (
      <li><a class="gd-nav__link" href={`#${s.id}`} data-gd-nav={s.id}>{s.t}</a></li>
    ))}
  </ul>
</nav>

<main>

{/* ─── 01 · APERTURA ─────────────────────────────────────────────
    Foto a sangre, titular debajo. Nada de texto sobre la imagen: en
    una marca clara obliga a velos oscuros, que es lo que sobra. */}
<section class="gd-open" id="apertura">
  <div class="gd-open__media" data-gd-parallax="0.08">
    <img src="/assets/img/cr-barra.jpg"
         srcset="/assets/img/cr-barra-m.jpg 900w, /assets/img/cr-barra.jpg 1800w"
         sizes="100vw" width="1800" height="1440"
         fetchpriority="high" decoding="async"
         alt="Arán y Noé detrás de la barra de Pipilacha, con los platos montados delante" />
  </div>
  <div class="gd-open__inner">
    <div class="gd-open__titulo">
      <p class="gd-eyebrow gd-reveal">{apertura.eyebrow}</p>
      <h1 class="gd-display gd-open__title" data-gd-words>{apertura.titulo}</h1>
    </div>
    <div class="gd-open__textos">
      <p class="gd-lede gd-open__sub gd-reveal">{apertura.sub}</p>
      <p class="gd-open__credit gd-reveal">{apertura.credito}</p>
    </div>
  </div>
</section>

{/* ─── 02 · QUÉ ES PIPILACHA · tres frases y nada más ───────────── */}
<section class="gd-scene gd-scene--alt" id="casa">
  <div class="gd-wrap gd-grid">
    <div class="gd-casa">
      <h2 class="gd-h1 gd-casa__t" data-gd-words>{casa.titulo}</h2>
      {casa.frases.map((p) => <p data-gd-lines>{p}</p>)}
    </div>
  </div>
</section>

{/* ─── 03 · LO QUE PASA EN LA MESA · descriptivo, no una lista de
     tareas: son cosas que ocurren solas durante el servicio ────── */}
<section class="gd-scene" id="mesa">
  <div class="gd-wrap">
    <header class="gd-head-b">
      <h2 class="gd-h1" data-gd-words>{mesa.titulo}</h2>
      <p class="gd-lede gd-reveal">{mesa.sub}</p>
    </header>
    <div class="gd-mesa" data-gd-stagger>
      {mesa.momentos.map((m) => (
        <article class="gd-mesa__item gd-item">
          <p class="gd-mesa__v">{m.v}</p>
          <h3 class="gd-mesa__k">{m.k}</h3>
          <p class="gd-mesa__d">{m.d}</p>
        </article>
      ))}
    </div>

    {/* tres pases, para poner cara a lo de arriba. Se hojea con el pulgar. */}
    <div class="gd-tira gd-reveal">
      {tira.map((t) => (
        <figure class="gd-tira__item">
          <img src={`/assets/img/${t.img}.jpg`} width="1400" height="1750" loading="lazy" decoding="async" alt={t.alt} />
          <figcaption>{t.pie}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

{/* ─── figura · el taco en el campo ──────────────────────────────── */}
<figure class="gd-fig">
  <div class="gd-fig__media"><img src={`/assets/img/${figuras.bosque.img}.jpg`} width="1600" height="2000" loading="lazy" decoding="async" alt={figuras.bosque.alt} /></div>
  <figcaption class="gd-reveal">
    <div class="gd-fig__texto">
      <span class="gd-fig__n">Pase {figuras.bosque.n}</span>
      <h2 class="gd-h2">{figuras.bosque.t}</h2>
      <p class="gd-body" style="margin-top:.6rem">{figuras.bosque.d}</p>
    </div>
  </figcaption>
</figure>

{/* ─── 04 · LAS FLORES · la única escena musgo de la página ───────
    Es el material que no está en ningún otro sitio: treinta y cuatro
    flores con lo que aporta cada una. */}
<section class="gd-scene gd-scene--moss" id="flores">
  <div class="gd-wrap">
    <header class="gd-head-b">
      <p class="gd-eyebrow gd-reveal">{menuNombre}</p>
      <h2 class="gd-h1" data-gd-words>{flores.titulo}</h2>
      <p class="gd-lede gd-reveal">{flores.sub}</p>
    </header>

    <div class="gd-filtro gd-reveal">
      <label class="sr-only" for="gd-buscar">Buscar flor</label>
      <input class="gd-filtro__input" id="gd-buscar" type="search" placeholder="Buscar flor" autocomplete="off" data-gd-buscar />
    </div>

    <ul class="gd-dicc" data-gd-dicc>
      {floresSabor.map((f) => (
        <li class="gd-dicc__item gd-reveal" data-gd-flor={f.n}>
          <p class="gd-dicc__n">{f.n}</p>
          <p class="gd-dicc__s">{f.sabor}</p>
          <p class="gd-dicc__pase">Pase {String(f.pase).padStart(2, '0')}</p>
        </li>
      ))}
    </ul>
    <p class="gd-dicc__vacio" data-gd-vacio hidden>{flores.vacio}</p>
    <p class="gd-dicc__aviso gd-reveal">{flores.aviso}</p>
  </div>
</section>

{/* ─── 05 · IDEAS · puntos de partida, no un encargo ─────────────── */}
<section class="gd-scene" id="ideas">
  <div class="gd-wrap">
    <header class="gd-head-b">
      <h2 class="gd-h1" data-gd-words>{ideas.titulo}</h2>
      <p class="gd-lede gd-reveal">{ideas.sub}</p>
    </header>
    <div class="gd-carril gd-reveal">
      {ideas.lista.map((i) => (
        <article class="gd-idea">
          <span class="gd-idea__f">{i.f}</span>
          <h3 class="gd-idea__t">{i.t}</h3>
          <p class="gd-idea__d">{i.d}</p>
        </article>
      ))}
    </div>
    <p class="gd-idea__nota gd-reveal">{ideas.nota}</p>
  </div>
</section>

{/* ─── figura · Arán y Noé ───────────────────────────────────────── */}
<figure class="gd-fig">
  <div class="gd-fig__media"><img src={`/assets/img/${figuras.retiro.img}.jpg`} width="1600" height="2000" loading="lazy" decoding="async" alt={figuras.retiro.alt} /></div>
  <figcaption class="gd-reveal">
    <div class="gd-fig__texto">
      <h2 class="gd-h2">{figuras.retiro.t}</h2>
      <p class="gd-body" style="margin-top:.6rem">{figuras.retiro.d}</p>
    </div>
  </figcaption>
</figure>

{/* ─── 06 · FRASES · copiables de un toque ───────────────────────── */}
<section class="gd-scene gd-scene--alt" id="frases">
  <div class="gd-wrap">
    <header class="gd-head-b">
      <h2 class="gd-h1" data-gd-words>{frases.titulo}</h2>
      <p class="gd-lede gd-reveal">{frases.sub}</p>
    </header>

    <div class="gd-grid">
      <div class="gd-frases">
        <div class="gd-hooks" data-gd-stagger>
          {frases.hooks.map((h) => (
            <p class="gd-hook gd-item">
              <span>{h}</span>
              <button class="gd-copy" type="button" data-gd-copy={h} aria-label={`Copiar: ${h}`}>Copiar</button>
            </p>
          ))}
        </div>
      </div>
      <div class="gd-frases-lat">
        <div class="gd-caps">
          {frases.pies.map((c) => (
            <div class="gd-caption gd-reveal">
              <p class="gd-caption__t">{c.t}</p>
              <p class="gd-caption__d">{c.d}</p>
              <button class="gd-copy" type="button" data-gd-copy={c.d} aria-label={`Copiar pie: ${c.t}`}>Copiar</button>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

{/* ─── 07 · LO PRÁCTICO · incluye la invitación ──────────────────── */}
<section class="gd-scene" id="practico">
  <div class="gd-wrap gd-grid">
    <div class="gd-practico__head">
      <h2 class="gd-h1" data-gd-words>{practico.titulo}</h2>
    </div>
    <div class="gd-practico__cuerpo">
      <div class="gd-datos" data-gd-stagger>
        {practico.filas.map((f) => (
          <div class="gd-datos__row gd-item">
            <span class="gd-datos__k">{f.k}</span>
            <span class="gd-datos__v">{f.v}<br /><span class="gd-datos__sub">{f.sub}</span></span>
          </div>
        ))}
      </div>
      <div class="gd-invita gd-reveal">
        <p class="gd-invita__k">{practico.invitacion.t}</p>
        <p class="gd-invita__d">{practico.invitacion.d}</p>
        <p class="gd-invita__libre">{practico.invitacion.libre}</p>
      </div>
      <p class="gd-practico__tel gd-reveal">
        <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
        <span aria-hidden="true"> · </span>
        <a href={`tel:${contacto.tel}`}>{contacto.telLabel}</a>
      </p>
    </div>
  </div>
</section>

{/* ─── 08 · CIERRE ───────────────────────────────────────────────── */}
<section class="gd-scene gd-cierre">
  <h2 class="gd-h1 gd-cierre__big" data-gd-words>{cierre.titulo}</h2>
  <a class="gd-btn gd-btn--big gd-reveal" href={dmUrl} target="_blank" rel="noopener">{cierre.cta}</a>
</section>

</main>
</Garden>
