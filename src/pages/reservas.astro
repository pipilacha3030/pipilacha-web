---
import Base from '../layouts/Base.astro';
---

<Base
  title="Reservar · Pipilacha"
  description="Reserva tu mesa en Pipilacha. 16 plazas por servicio, jueves a domingo, dos turnos. Menú degustación 85 € por persona."
>

  <section class="page-header">
    <p class="eyebrow">La mesa</p>
    <h1>Reservar mesa<br>en Pipilacha</h1>
    <p>Hay 16 plazas por servicio. Reservar con antelación es la norma, no la excepción.</p>
  </section>

  <!-- RESERVA -->
  <section class="reserva" id="reserva">
    <img src="/assets/img/petal-sauco.png" class="petal petal--2" alt="" aria-hidden="true" />
    <img src="/assets/img/petal-peony.png" class="petal petal--3" alt="" aria-hidden="true" />
    <div class="reserva__card reveal">
      <ul class="reserva__details">
        <li><span>Días</span><strong>Jueves a domingo</strong></li>
        <li><span>Servicios</span><strong>14:00 y 21:00</strong></li>
        <li><span>Menú degustación</span><strong>85 € / persona</strong></li>
        <li><span>Maridaje</span><strong>+60 € / persona</strong></li>
        <li><span>Duración</span><strong>2 horas</strong></li>
      </ul>
      <a href="#reservar-widget" class="btn btn--solid btn--lg">Reservar ahora</a>
      <p class="reserva__note">¿Dudas? Escríbenos por <a href="https://instagram.com/restaurante.pipilacha" target="_blank" rel="noopener">Instagram</a> o llama al <a href="tel:+34919125998">919 12 59 98</a>.</p>
    </div>
  </section>

  <!-- WIDGET THEFORK (reserva online, inline) -->
  <section class="reserva-widget" id="reservar-widget">
    <div class="reserva-widget__inner">
      <iframe
        src="https://widget.thefork.com/867dcee9-49b5-47ed-90c0-c6c87149b328"
        allow="payment *"
        title="Reservas Pipilacha"
        loading="lazy"
        style="width:100%; min-height:800px; border:none;">
      </iframe>
    </div>
  </section>

</Base>
