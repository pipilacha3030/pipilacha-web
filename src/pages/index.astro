---
import Base from '../layouts/Base.astro';

/* GALLERY FLOW · runway alto que pinnea UNA fila de altura completa (efecto 072).
   12 imágenes únicas (platos, flor, cocina, retratos, sala) — se duplican en JS
   para el loop seamless. size = altura base (sm/md/lg → varias dimensiones).
   Flujo denso y continuo R→L: siempre se ven varias a la vez, expandiéndose al
   pasar por el centro, con un leve wobble orgánico (ver initGalleryFlow). */
const gallery = [
  { src:'/assets/img/df-vieira.jpg',    alt:'Vieira con flor de higo en dos cuencos de cerámica — Pipilacha',          size:'lg' },
  { src:'/assets/img/df-mandarina.jpg', alt:'Torrija de mandarina coronada con caléndula y capuchina — Pipilacha',     size:'sm' },
  { src:'/assets/img/g3.jpg',           alt:'Guisante lágrima con saúco y flores en cuenco de mármol — Pipilacha',     size:'md' },
  { src:'/assets/img/dish-2.jpg',       alt:'Espárragos a la brasa con romesco y pétalos de caléndula — Pipilacha',    size:'sm' },
  { src:'/assets/img/dish-3.jpg',       alt:'Clavel fucsia sobre crema, en primer plano — Pipilacha',                  size:'lg' },
  { src:'/assets/img/g11.jpg',          alt:'Helado cítrico con pétalos de clavel sostenido en la mano — Pipilacha',   size:'md' },
  { src:'/assets/img/g17.jpg',          alt:'Crema fría con hojas de capuchina, emplatada a mano — Pipilacha',         size:'sm' },
  { src:'/assets/img/chef-1.jpg',       alt:'Arán, chef de Pipilacha, entre flores amarillas — Pipilacha',             size:'lg' },
  { src:'/assets/img/noe-barra.jpg',    alt:'Noé, chef de Pipilacha, en la cocina — Pipilacha',                        size:'md' },
  { src:'/assets/img/g16.jpg',          alt:'Arán y Noé cocinando juntos en la barra — Pipilacha',                     size:'md' },
  { src:'/assets/img/g6.jpg',           alt:'Manos de los chefs emplatando espárragos sobre pizarras — Pipilacha',     size:'lg' },
  { src:'/assets/img/barra.jpg',        alt:'La barra de iroko vestida para el servicio con un centro floral — Pipilacha', size:'md' },
];
---

<Base
  title="Pipilacha · El único restaurante construido sobre las flores"
  description="Pipilacha es un restaurante de degustación en Madrid donde las flores no son adorno: son el concepto. 16 plazas por servicio. Jueves a domingo."
  solidNav={false}
>

  <!-- HERO -->
  <section class="hero" id="hero">
    <div class="hero__media" data-parallax="0.25">
      <img src="/assets/img/hero.jpg" alt="Cuenco de cerámica lleno de flores comestibles sostenido entre las manos" />
      <div class="hero__veil"></div>
    </div>
    <div class="hero__content">
      <p class="eyebrow reveal" data-delay="0.1">Restaurante de degustación · Madrid</p>
      <h1 class="hero__title">
        <span class="line"><span class="reveal-mask">Un menú entero</span></span>
        <span class="line"><span class="reveal-mask">hecho de flores.</span></span>
      </h1>
      <p class="hero__sub reveal" data-delay="0.5">El único restaurante del mundo construido íntegramente sobre las flores.</p>
      <div class="hero__actions">
        <a href="/reservas/" class="btn btn--solid reveal" data-delay="0.65">Reservar</a>
        <a href="/regala/" class="btn btn--ghost reveal" data-delay="0.75">Regalar</a>
      </div>
    </div>
  </section>

  <!-- QUIÉNES SOMOS: identidad editorial, full-bleed, cascada tipográfica -->
  <section class="quienes" id="quienes">
    <div class="quienes__visual">
      <figure class="quienes__media" data-parallax="0.2">
        <img src="/assets/img/chef-3.jpg" alt="Arán Rodrigo y Noé David en la cocina de Pipilacha" loading="lazy" decoding="async" />
      </figure>
      <div class="quienes__veil" aria-hidden="true"></div>
    </div>
    <div class="quienes__body">
      <div class="quienes__inner">
        <h2 class="quienes__h2 reveal">Un restaurante para curiosos.</h2>
        <p class="quienes__text reveal">
          Quince pases y en todos manda una flor distinta. No de adorno: como ingrediente principal,
          cocinada hasta donde llega su sabor. Esto no lo vas a encontrar en ningún otro restaurante
          de Madrid, porque casi nadie lo ha intentado. Te sientas en la barra, lo ves hacerse a un
          metro, y sales habiendo probado cosas que no existen en ningún otro sitio.
        </p>
<a href="/conocenos/" class="quienes__link reveal">Quiénes están detrás →</a>
      </div>
    </div>
  </section>

  <!-- GALLERY FLOW · runway alto que pinnea una fila que viaja horizontal y expande -->
  <section class="gallery" id="gallery" aria-label="Las imágenes de Pipilacha en movimiento">
    <div class="gallery-row">
      {gallery.map((g) => (
        <figure class:list={['gallery-img', `gallery-img--${g.size}`]}>
          <img src={g.src} alt={g.alt} loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </section>

  <!-- DESPERTAR DE LAS FLORES (4 imágenes en bucle: Timeline + clip-path) -->
  <section class="showcase-wrap" id="despertar">
    <a class="showcase" href="/menu/" aria-label="Ver el menú Despertar de las flores">
      <div class="showcase__frame">
        <figure class="showcase__layer" data-layer="0"><img src="/assets/img/df-esparrago.jpg" alt="Espárragos a la brasa con romesco de tagete" loading="lazy" decoding="async" /></figure>
        <figure class="showcase__layer" data-layer="1"><img src="/assets/img/df-guisante.jpg" alt="Guisante coco-saúco" loading="lazy" decoding="async" /></figure>
        <figure class="showcase__layer" data-layer="2"><img src="/assets/img/df-vieira.jpg" alt="Vieira con flor de higo" loading="lazy" decoding="async" /></figure>
        <figure class="showcase__layer" data-layer="3"><img src="/assets/img/df-mandarina.jpg" alt="Torrija de mandarina" loading="lazy" decoding="async" /></figure>
        <span class="showcase__veil" aria-hidden="true"></span>
      </div>
      <span class="showcase__cap">
        <span class="eyebrow">El menú</span>
        <span class="showcase__title">Despertar de las flores</span>
        <span class="showcase__more">Ver los pases →</span>
      </span>
    </a>
  </section>

  <!-- CINTA (pequeña y clara, con flores; texto con keywords para SEO) -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <div class="marquee__group">
        <span>Restaurante de flores en Madrid</span><span class="marquee__sep">✿</span>
        <span>Menú de degustación · 15 pases</span><span class="marquee__sep">✿</span>
        <span>Cocina floral de autor</span><span class="marquee__sep">✿</span>
        <span>Flores comestibles como ingrediente</span><span class="marquee__sep">✿</span>
        <span>Fuente del Berro · Jueves a domingo</span><span class="marquee__sep">✿</span>
      </div>
      <div class="marquee__group">
        <span>Restaurante de flores en Madrid</span><span class="marquee__sep">✿</span>
        <span>Menú de degustación · 15 pases</span><span class="marquee__sep">✿</span>
        <span>Cocina floral de autor</span><span class="marquee__sep">✿</span>
        <span>Flores comestibles como ingrediente</span><span class="marquee__sep">✿</span>
        <span>Fuente del Berro · Jueves a domingo</span><span class="marquee__sep">✿</span>
      </div>
    </div>
  </div>

  <!-- EXPLORAR — editorial full-bleed, imágenes siempre visibles -->
  <nav class="explore" aria-label="Secciones">
    <a href="/conocenos/" style="--img:url(/assets/img/enlace-conocenos.jpg); --posy:38%">
      <span class="explore__n">01</span><span class="explore__label">Conócenos</span>
    </a>
    <a href="/menu/" style="--img:url(/assets/img/enlace-menu.jpg); --posy:50%">
      <span class="explore__n">02</span><span class="explore__label">El menú</span>
    </a>
    <a href="/galeria/" style="--img:url(/assets/img/enlace-galeria.jpg); --posy:40%">
      <span class="explore__n">03</span><span class="explore__label">Galería</span>
    </a>
  </nav>

  <!-- LA BARRA (imagen + texto, retícula editorial) -->
  <section class="barra" id="barra">
    <div class="barra__grid">
      <figure class="barra__media reveal">
        <img src="/assets/img/barra.jpg" alt="La barra de iroko de seis metros, puesta para el servicio" loading="lazy" />
        <figcaption class="barra__tag">Barra de iroko</figcaption>
      </figure>
      <div class="barra__content">
        <p class="eyebrow reveal">La barra</p>
        <h2 class="barra__title reveal">Seis metros de iroko.<br>Los chefs al otro lado.</h2>
        <p class="barra__lead reveal">Ocho asientos en primera línea. Arán y Noé cocinan delante de ti y cuentan cada flor según la sirven. Tu plato nace ahí, a un brazo de distancia.</p>
        <ul class="barra__facts reveal">
          <li><strong>8</strong><span>asientos en barra</span></li>
          <li><strong>6 m</strong><span>de iroko macizo</span></li>
          <li><strong>2</strong><span>chefs enfrente</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- RESERVA (tarjeta de datos) -->
  <section class="reserva" id="reserva">
    <img src="/assets/img/petal-borraja.png" class="petal petal--2" alt="" aria-hidden="true" />
    <img src="/assets/img/petal-oxalis.png" class="petal petal--3" alt="" aria-hidden="true" />
    <div class="reserva__card reveal">
      <ul class="reserva__details">
        <li><span>Días</span><strong>Jueves a domingo</strong></li>
        <li><span>Servicios</span><strong>14:00 y 21:00</strong></li>
        <li><span>Menú degustación</span><strong>85 € / persona</strong></li>
        <li><span>Maridaje</span><strong>+60 € / persona</strong></li>
        <li><span>Duración</span><strong>2 horas</strong></li>
      </ul>
      <a href="/reservas/" class="btn btn--solid btn--lg">Reservar</a>
      <p class="reserva__note">¿Dudas? Escríbenos por <a href="https://instagram.com/restaurante.pipilacha" target="_blank" rel="noopener">Instagram</a> o llama al <a href="tel:+34919125998">919 12 59 98</a>.</p>
    </div>
  </section>

</Base>
