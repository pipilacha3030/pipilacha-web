---
import Base from '../layouts/Base.astro';
import PrimeraFila from '../components/PrimeraFila.astro';
import { aggregate, reviewsEs as reviews } from '../data/reviews.js';

// salvaguarda: solo reseñas reales (descarta cualquier `draft`). Y repite lo justo
// para llenar el raíl sin costura aunque haya pocas → el bucle nunca "termina".
const real = reviews.filter((r) => !r.draft);
const reps = Math.max(1, Math.ceil(9 / Math.max(1, real.length)));
const groupReviews = Array.from({ length: reps }).flatMap(() => real);
---

<Base
  title="Pipilacha · El único restaurante construido sobre las flores"
  description="Pipilacha es un restaurante de degustación en Madrid donde las flores no son adorno: son el ingrediente principal. 16 plazas por servicio. Jueves a domingo."
>

  <!-- HERO → QUIÉNES · escenario de "slides" a pantalla completa.
       Escritorio (≥901px): heroQuienesScroll.js intercepta el gesto (GSAP
       Observer) y hace la transición discreta — el hero sube y «quiénes» entra
       desde abajo, un slide por gesto, sin scroll libre. Al salir de la zona
       (arriba o abajo) devuelve el scroll a Lenis. Móvil / reduced-motion: no
       hay jack, las dos secciones quedan apiladas en flujo normal. -->
  <div class="fs-scroll" id="fsScroll">
    <div class="fs-stage">

      <!-- HERO -->
      <section class="hero fs-slide" id="hero" data-fs-slide="0">
        <div class="hero__media" data-parallax="0.15">
          <img
            src="/assets/img/hero.jpg"
            srcset="/assets/img/hero-m.jpg 1920w, /assets/img/hero.jpg 3840w"
            sizes="100vw"
            width="3840" height="2160"
            fetchpriority="high" decoding="async"
            alt="Cuenco de cerámica lleno de flores comestibles sostenido entre las manos" />
          <div class="hero__veil"></div>
        </div>
        <div class="hero__content">
          <!-- único texto del hero: hace de h1 de la página (estructura correcta),
               pero mantiene el tamaño pequeño de .hero__sub -->
          <h1 class="hero__sub reveal" data-delay="0.5">Durante siglos las flores se contemplaron. Ahora también se degustan.</h1>
          <div class="hero__actions">
            <a href="/reservas/" class="btn btn--solid btn--shine reveal" data-delay="0.65"><span>Reserva</span></a>
            <a href="/regala/" class="btn btn--ghost btn--shine reveal" data-delay="0.75"><span>Regala</span></a>
          </div>
        </div>
      </section>

      <!-- QUIÉNES SOMOS · la panorámica de la barra a sangre completa. En
           escritorio entra empujando al hero; el texto se posa sobre el velo. -->
      <section class="quienes fs-slide" id="quienes" data-fs-slide="1">
        <figure class="quienes__media">
          <img
            src="/assets/img/barra-aran-noe.jpg"
            srcset="/assets/img/barra-aran-noe-m.jpg 1600w, /assets/img/barra-aran-noe.jpg 2560w"
            sizes="100vw"
            width="2560" height="1209"
            alt="Arán y Noé tras la barra de Pipilacha, con los pases de flores emplatados delante"
            loading="lazy" decoding="async" />
        </figure>
        <div class="quienes__copy">
          <h2 class="quienes__h2">Un menú entero hecho de flores.</h2>
          <p class="quienes__text">
            Quince pases y en todos manda una flor distinta. No de adorno: como ingrediente principal,
            cocinada hasta donde llega su sabor. Esto no lo vas a encontrar en ningún otro restaurante
            de Madrid, porque casi nadie lo ha intentado. Te sientas en la barra, lo ves hacerse a un
            metro, y sales habiendo probado cosas que no existen en ningún otro sitio.
          </p>
          <a href="/conocenos/" class="quienes__link">Quiénes están detrás →</a>
        </div>
      </section>

      <!-- SOLSTICIO FLORAL · tercera escena del mismo escenario a pantalla
           completa: tarjeta con 4 fotos en crossfade (showcase.js), a sangre. -->
      <section class="gallery fs-slide" id="gallery" data-fs-slide="2" aria-label="Solsticio floral">
        <div class="gallery__stage">
        <a class="gallery-finale showcase" id="despertar" href="/menu/" aria-label="Ver el menú Solsticio floral">
          <div class="showcase__frame">
            <figure class="showcase__layer" data-layer="0"><img src="/assets/img/df-esparrago.jpg" alt="Espárragos a la brasa con romesco de tagete" loading="eager" fetchpriority="low" decoding="async" /></figure>
            <figure class="showcase__layer" data-layer="1"><img src="/assets/img/df-guisante.jpg" alt="Guisante coco-saúco" loading="eager" fetchpriority="low" decoding="async" /></figure>
            <figure class="showcase__layer" data-layer="2"><img src="/assets/img/df-vieira.jpg" alt="Vieira con flor de higo" loading="eager" fetchpriority="low" decoding="async" /></figure>
            <figure class="showcase__layer" data-layer="3"><img src="/assets/img/df-mandarina.jpg" alt="Torrija de mandarina" loading="eager" fetchpriority="low" decoding="async" /></figure>
            <span class="showcase__veil" aria-hidden="true"></span>
          </div>
          <span class="showcase__cap">
            <span class="eyebrow">El menú de verano</span>
            <span class="showcase__title">Solsticio floral</span>
            <span class="showcase__more">Ver los pases →</span>
          </span>
        </a>
        </div>
      </section>

    </div>
  </div>

  <!-- INTERLUDIO: standfirst editorial entre el escenario a sangre (hero →
       quiénes → solsticio floral) y la prueba social. Una sola frase serif
       que se revela al entrar en viewport (.reveal, sin JS propio); recoge en
       prosa los dos datos que antes corrían en la cinta. -->
  <section class="interlude">
    <div class="interlude__blooms" aria-hidden="true">
      <span class="interlude__bloom interlude__bloom--1"><span class="interlude__bloom-in"><img src="/assets/img/flor-cosmos.png" alt="" loading="lazy" decoding="async" /></span></span>
      <span class="interlude__bloom interlude__bloom--2"><span class="interlude__bloom-in"><img src="/assets/img/flor-dalia.png" alt="" loading="lazy" decoding="async" /></span></span>
      <span class="interlude__bloom interlude__bloom--3"><span class="interlude__bloom-in"><img src="/assets/img/flor-borraja.png" alt="" loading="lazy" decoding="async" /></span></span>
      <span class="interlude__bloom interlude__bloom--4"><span class="interlude__bloom-in"><img src="/assets/img/flor-calendula.png" alt="" loading="lazy" decoding="async" /></span></span>
      <span class="interlude__bloom interlude__bloom--5"><span class="interlude__bloom-in"><img src="/assets/img/flor-aciano.png" alt="" loading="lazy" decoding="async" /></span></span>
    </div>
    <div class="interlude__figure">
      <span class="interlude__num" aria-hidden="true">35</span>
      <p class="interlude__line">Treinta y cinco flores comestibles, una sola temporada.</p>
    </div>
  </section>

  <!-- PRUEBA SOCIAL: valoración agregada (Google) + carrusel de reseñas en bucle.
       Sprint 4 · storytelling: sube antes de Primera Fila — la confianza (otros ya
       lo vivieron) se establece justo antes del clímax sensorial que cierra en reserva. -->
  <section class="proof" aria-labelledby="proof-h">
    <div class="proof__blooms" aria-hidden="true">
      <span class="proof__bloom proof__bloom--1"><img src="/assets/img/flor-coreopsis.png" alt="" loading="lazy" decoding="async" /></span>
      <span class="proof__bloom proof__bloom--2"><img src="/assets/img/flor-cosmos.png" alt="" loading="lazy" decoding="async" /></span>
      <span class="proof__bloom proof__bloom--3"><img src="/assets/img/flor-amapola.png" alt="" loading="lazy" decoding="async" /></span>
      <span class="proof__bloom proof__bloom--4"><img src="/assets/img/flor-borraja.png" alt="" loading="lazy" decoding="async" /></span>
      <span class="proof__bloom proof__bloom--5"><img src="/assets/img/flor-aciano.png" alt="" loading="lazy" decoding="async" /></span>
      <span class="proof__bloom proof__bloom--6"><img src="/assets/img/flor-calendula.png" alt="" loading="lazy" decoding="async" /></span>
      <span class="proof__bloom proof__bloom--7"><img src="/assets/img/flor-dalia.png" alt="" loading="lazy" decoding="async" /></span>
      <span class="proof__bloom proof__bloom--8"><img src="/assets/img/flor-geranio.png" alt="" loading="lazy" decoding="async" /></span>
      <span class="proof__bloom proof__bloom--9"><img src="/assets/img/flor-clavel.png" alt="" loading="lazy" decoding="async" /></span>
    </div>
    <div class="proof__inner">
      <div class="proof__rating reveal">
        <span class="proof__stars" aria-hidden="true">★★★★★</span>
        <p class="proof__score"><strong>{aggregate.rating}</strong> / 5</p>
        <p class="proof__meta">{aggregate.count} reseñas en Google</p>
      </div>
      <h2 class="proof__title reveal" id="proof-h">Lo que permanece después del último pase.</h2>
    </div>

    <!-- raíl full-bleed: dos grupos idénticos → bucle sin costura (reviews.js) -->
    <div class="reviews reveal" data-reviews>
      <div class="reviews__track">
        {[false, true].map((dup) => (
          <div class="reviews__group" aria-hidden={dup ? 'true' : undefined}>
            {groupReviews.map((r) => (
              <a
                class="review-card"
                href={aggregate.url}
                target="_blank"
                rel="noopener"
                tabindex={dup ? -1 : undefined}
                aria-label={dup ? undefined : `Reseña de ${r.author} en ${r.source} — ver en Google`}
              >
                <span class="review-card__head">
                  <img class="review-card__photo" src={r.photo} width="96" height="96" alt="" loading="lazy" decoding="async" />
                  <span class="review-card__who">
                    <span class="review-card__author">{r.author}</span>
                    <span class="review-card__src">{r.source}</span>
                  </span>
                  <span class="review-card__mark" aria-hidden="true">✿</span>
                </span>
                <span class="review-card__stars" aria-hidden="true">★★★★★</span>
                <blockquote>{r.text}</blockquote>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="proof__inner">
      <a class="proof__link reveal" href={aggregate.url} target="_blank" rel="noopener">Ver todas las reseñas en Google →</a>
    </div>
  </section>

  <!-- PRIMERA FILA — capítulo inmersivo: OBSERVAR → ESCUCHAR → DESCUBRIR → reserva.
       Sprint 4 · storytelling: el clímax de la historia — ya termina en su propia
       llamada a reservar, así que sube de la cola de la página a este punto. -->
  <PrimeraFila />

  <!-- EXPLORAR — editorial full-bleed, imágenes siempre visibles.
       Sprint 4 · storytelling: baja al final — es un hub de navegación (duplica
       destinos ya enlazados en Quiénes/Despertar), no un beat narrativo; ahora
       es la puerta de salida suave para quien quiera explorar antes de decidir,
       en vez de interrumpir la historia a mitad de camino. -->
  <nav class="explore" aria-label="Secciones">
    <a href="/conocenos/" style="--img:url(/assets/img/enlace-conocenos.jpg); --posy:38%">
      <span class="explore__label">Conócenos</span>
    </a>
    <a href="/menu/" style="--img:url(/assets/img/enlace-menu.jpg); --posy:50%">
      <span class="explore__label">El menú</span>
    </a>
    <a href="/galeria/" style="--img:url(/assets/img/enlace-galeria.jpg); --posy:40%">
      <span class="explore__label">Galería</span>
    </a>
  </nav>

</Base>
