---
import Base from '../layouts/Base.astro';
---

<Base
  title="Regala Pipilacha · El menú de flores, para regalar"
  description="Regala una experiencia en Pipilacha: el menú de degustación Despertar de las flores, quince pases entre flores, en Madrid. Tarjeta regalo válida un año."
>

  <!-- COMPRA · widget externo Bonkdo (provisional, hasta el sistema de regalo propio) -->
  <section class="gift-shop" id="comprar">
    <p class="eyebrow reveal">Comprar la tarjeta</p>
    <h1 class="reveal-head">Regálalo ahora</h1>
    <p class="gift-shop__lead reveal">Elige importe o menú y te llega la tarjeta con su código. El día se reserva luego por TheFork.</p>
    <div class="gift-shop__frame reveal">
      <iframe
        id="giftFrame"
        src="https://pipilacha.bonkdo.com?embed=true&hide_main_title_description=false&hide_footer=false&hide_whychooseus=false&hide_create_money_pot=false&hide_group_payment=false&hide_shared_gifts_header=false&hide_whole_shared_gifts=false&hide_giftcards=false&hide_vouchers=false"
        title="Tarjetas regalo de Pipilacha"
        loading="lazy"
        style="width:100%;border:0"></iframe>
    </div>
  </section>
  <script is:inline src="https://pipilacha.bonkdo.com/static/js/iframeResizer.min.js"></script>
  <script is:inline>iFrameResize()</script>

</Base>
