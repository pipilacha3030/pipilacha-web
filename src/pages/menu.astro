---
import Base from '../layouts/Base.astro';
import { pases } from '../data/menu.js';

// Schema.org: el menú (coincide con los 15 pases listados en la página).
// El @id es la URL de la página: el Restaurant del grafo base (Base.astro)
// apunta aquí vía hasMenu, y buscadores/LLMs cierran el círculo.
const menuSchema = `<script type="application/ld+json">${JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Menu",
  "@id": "https://pipilacha.es/menu/",
  "url": "https://pipilacha.es/menu/",
  "mainEntityOfPage": "https://pipilacha.es/menu/",
  "name": "Despertar de las flores",
  "inLanguage": "es",
  "description": "Menú de degustación de quince pases con flores comestibles como ingrediente. 85 € por persona.",
  "hasMenuSection": {
    "@type": "MenuSection",
    "name": "Despertar de las flores · 15 pases",
    "hasMenuItem": pases.map((p) => p.surprise
      ? { "@type": "MenuItem", "name": "Pase sorpresa", "description": "A ciegas, se descubre en la mesa." }
      : { "@type": "MenuItem", "name": p.name, "description": p.hook })
  },
  "offers": { "@type": "Offer", "price": "85.00", "priceCurrency": "EUR" }
})}</script>`;
---

<Base
  title="Menú · Despertar de las flores · Pipilacha"
  description="Despertar de las flores: el menú de degustación de Pipilacha. Quince pases con las flores como ingrediente. Madrid, 85 € por persona."
  schema={menuSchema}
>

  <!-- progressive blur: el contenido se disuelve en degradado en los bordes del viewport -->
  <div class="pblur pblur--top" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  <div class="pblur pblur--bottom" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>

  <section class="page-header">
    <p class="eyebrow">Degustación · Primavera</p>
    <h1 class="reveal-head">Despertar de las flores</h1>
    <p>Quince pases. Sin carta, sin alternativa: se sirve completo. Cada uno con una pista; el resto te lo contamos en la mesa. El décimo te lo guardamos.</p>
  </section>

  <!-- LISTA DE PASES (nombre + pista) sobre fondo verde moss -->
  <section class="menu" id="menu">
    <div class="menu__inner">
    <span class="pases__stem" aria-hidden="true"></span>
    <ol class="pases">
      {pases.map((p, i) => (
        p.surprise ? (
          <li class="pase pase--secret reveal">
            <span class="pase__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="pase__body" aria-label="Pase sorpresa, sin desvelar">
              <span class="pase__name pase__name--secret">Te lo guardamos</span>
              <span class="pase__hook">Un pase a ciegas. Lo descubres en la mesa, sin saber qué flor llega.</span>
            </span>
          </li>
        ) : (
          <li class="pase reveal">
            <span class="pase__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="pase__body">
              <span class="pase__name">{p.name}</span>
              <span class="pase__hook">{p.hook}</span>
            </span>
          </li>
        )
      ))}
    </ol>
    </div>
  </section>

  <!-- MARIDAJE -->
  <section class="maridaje" id="maridaje">
    <div class="maridaje__inner">
      <p class="eyebrow reveal">La otra mitad</p>
      <h2 class="reveal">Maridaje</h2>
      <p class="maridaje__intro reveal">Seis copas para recorrer los quince pases. Vinos de productores pequeños o los fermentos que hacemos en casa. Se elige al sentarse y ninguno está en carta: se sirve y se explica en sala.</p>
      <div class="maridaje__cards" data-reveal-stagger>
        <article class="maridaje__card reveal">
          <span class="maridaje__count">Seis copas</span>
          <h3>Con vino</h3>
          <p>Elegidas para la temporada. Cambian con las flores que entran cada servicio.</p>
          <span class="maridaje__price">+60 € / persona</span>
        </article>
        <article class="maridaje__card reveal">
          <span class="maridaje__count">Seis fermentos</span>
          <h3>Sin alcohol</h3>
          <p>Kombuchas, kéfires de agua y cheongs de flor, hechos en casa. La misma ambición, sin vino.</p>
          <span class="maridaje__price">+60 € / persona</span>
        </article>
      </div>
      <p class="maridaje__more reveal"><a href="/vinos/">Ver la carta de vinos <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="cta-band">
    <h2 class="reveal">El menú se cuenta en mesa</h2>
    <p class="cta-band__lead reveal">Qué flor entra en cada plato, qué hace y de dónde viene la idea. Reserva y te lo contamos pase a pase.</p>
    <a href="/reservas/" class="btn btn--solid btn--lg reveal">Reservar</a>
  </section>

</Base>
