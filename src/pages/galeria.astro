  { src: '/assets/img/g8.jpg',  alt: 'Vieira con flor de higo',             left: '2430px', top: '40%', w: '362px', h: '242px', rot:  3.0 },
  { src: '/assets/img/g14.jpg', alt: 'La sala',                              left: '2610px', top: '60%', w: '298px', h: '398px', rot: -2.0 },
  { src: '/assets/img/g5.jpg',  alt: 'Guiso de setas',                      left: '2790px', top: '16%', w: '348px', h: '233px', rot:  2.5 },
