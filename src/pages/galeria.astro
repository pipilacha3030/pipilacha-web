---
import Base from '../layouts/Base.astro';
import { fotos } from '../data/galeria.js';
import { dims } from '../data/galeria-dims.js';

// SEO: ImageGallery (12 fotos representativas, no las 76 — decorativo si se repite
// una por una). about enlaza al @id del Restaurant del grafo base (Base.astro).
const galleryLd = `<script type="application/ld+json">${JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  '@id': 'https://pipilacha.es/galeria/',
  url: 'https://pipilacha.es/galeria/',
  name: 'Galería · Pipilacha',
  description: 'Platos, flores y servicio en Pipilacha, restaurante de degustación floral en Madrid.',
  inLanguage: 'es',
  about: { '@id': 'https://pipilacha.es/#restaurant' },
  associatedMedia: fotos.slice(0, 12).map((f) => ({
    '@type': 'ImageObject',
    contentUrl: `https://pipilacha.es${f.src}`,
    caption: f.alt,
  })),
})}</script>`;
---

<Base
  title="Galería · Pipilacha"
  description="Platos, flores y servicio en Pipilacha, restaurante de degustación floral en Madrid."
  ogImage="/assets/img/og-galeria.jpg"
  schema={galleryLd}
>

  <section class="gal-stage" id="galStage" aria-roledescription="carrusel" aria-label="Galería inmersiva" tabindex="0">
    <canvas class="gal-stage__bg" id="galBg" aria-hidden="true"></canvas>

    <ul class="gal-track" id="galTrack">
      {fotos.map((f, i) => {
        const [w, h] = dims[f.src.split('/').pop()] || [];
        // miniatura -m (800w) para móvil; el .htaccess sirve su avif/webp.
        // La grande queda como fallback y la usa el lightbox al ampliar.
        // sizes: en desktop el carrusel AGRANDA la foto central (~1400px) → pedimos
        // la grande (1280px) para no verla borrosa; en móvil la central no crece
        // tanto → basta la -m y ahorramos datos donde más importa.
        const mSrc = w > 800 ? f.src.replace(/\.jpg$/, '-m.jpg') : null;
        return (
        <li class="gal-card" data-index={i}>
          <button class="gal-card__btn" type="button" aria-label={`Ampliar: ${f.alt}`}>
            <img
              src={f.src}
              srcset={mSrc ? `${mSrc} 800w, ${f.src} ${w}w` : undefined}
              sizes={mSrc ? '(max-width: 900px) 70vw, 1280px' : undefined}
              alt={f.alt}
              width={w}
              height={h}
              loading={i < 10 ? 'eager' : 'lazy'}
              fetchpriority={i < 3 ? 'high' : undefined}
              decoding="async"
              draggable="false"
            />
          </button>
        </li>
        );
      })}
    </ul>

    <div class="gal-frame">
      <div class="gal-frame__top">
        <p class="eyebrow">Galería</p>
        <h1 class="gal-frame__title">Entre flores</h1>
      </div>
      <div class="gal-frame__bottom">
        <p class="gal-frame__count"><span id="galIdx">01</span> / {fotos.length}</p>
        <div class="gal-frame__links">
          <a href="https://instagram.com/restaurante.pipilacha" target="_blank" rel="noopener">@restaurante.pipilacha</a>
          <a href="/reservas/" class="gal-frame__cta">Reservar</a>
        </div>
      </div>
    </div>
  </section>

  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Galería ampliada">
    <button class="lightbox__close" id="lbClose" type="button" aria-label="Cerrar galería">&times;</button>
    <button class="lightbox__nav lightbox__prev" id="lbPrev" type="button" aria-label="Foto anterior">&lsaquo;</button>
    <figure class="lightbox__stage">
      <img id="lbImg" src="" alt="" />
      <figcaption class="lightbox__cap" id="lbCap"></figcaption>
    </figure>
    <button class="lightbox__nav lightbox__next" id="lbNext" type="button" aria-label="Foto siguiente">&rsaquo;</button>
  </div>

</Base>
