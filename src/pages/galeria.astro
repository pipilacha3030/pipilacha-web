  { src: '/assets/img/g3.jpg',  alt: 'Guisante coco-saúco',                 left: '1710px', top: '58%', w: '298px', h: '398px', rot:  3.5 },
  { src: '/assets/img/g19.jpg', alt: 'Saco de colirrábano con clavelina',    left: '1890px', top: '14%', w: '312px', h: '418px', rot: -2.5 },
