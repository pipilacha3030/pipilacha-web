---
import Base from '../layouts/Base.astro';
import MaridajePopup from '../components/MaridajePopup.astro';
import { grupos } from '../data/vinos.js';

// SEO: datos estructurados de la carta (schema.org Menu).
const menuLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  '@id': 'https://pipilacha.es/vinos/',
  url: 'https://pipilacha.es/vinos/',
  mainEntityOfPage: 'https://pipilacha.es/vinos/',
  name: 'Carta de vinos · Pipilacha',
  inLanguage: 'es',
  description: 'La bodega de Pipilacha: vinos de productores pequeños, naturales y de oficio, por copa y botella, para acompañar el menú de degustación floral en Madrid.',
  hasMenuSection: grupos.map((g) => ({
    '@type': 'MenuSection',
    name: g.titulo,
    description: g.nota,
    hasMenuItem: g.vinos.map((v) => ({
      '@type': 'MenuItem',
      name: v.nombre,
      description: v.uva,
    })),
  })),
};
---

<Base
  title="Vinos · La bodega de Pipilacha · Madrid"
  description="La carta de vinos de Pipilacha: productores pequeños, vinos naturales y de oficio, por copa y botella, elegidos para acompañar el menú de flores en Madrid. Cambia con la temporada."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(menuLd)} />

  <!-- HERO -->
  <header class="cellar-hero">
    <div class="menu-blooms" aria-hidden="true">
      <img class="menu-bloom menu-bloom--1" src="/assets/img/flor-amapola.png" alt="" />
      <img class="menu-bloom menu-bloom--3" src="/assets/img/flor-cosmos.png" alt="" />
      <img class="menu-bloom menu-bloom--5" src="/assets/img/flor-coreopsis.png" alt="" />
    </div>
    <div class="cellar-hero__inner">
      <p class="eyebrow reveal">Vinos</p>
      <h1 class="cellar-hero__title reveal-head">Un recorrido paralelo.</h1>
      <p class="cellar-hero__lead reveal">
        Cada temporada seleccionamos vinos de pequeños productores que acompañan el menú
        desde el primer pase hasta el último. Algunos realzan una flor. Otros aportan
        contraste. Todos están aquí por una razón.
      </p>
    </div>
  </header>

  <!-- SELECCIÓN -->
  <section class="cellar-intro">
    <h2 class="reveal">La selección</h2>
    <p class="reveal">
      La carta cambia con las estaciones y reúne vinos elegidos por su capacidad para
      dialogar con la cocina, no por seguir tendencias. Puedes descubrirlos por copa o
      por botella.
    </p>
  </section>

  <!-- BODEGA: índice pegajoso + secciones editoriales -->
  <div class="cellar">
    <aside class="cellar-index" aria-label="Tipos de vino">
      <p class="cellar-index__title">La carta</p>
      <ol class="cellar-index__list">
        {grupos.map((g) => (
          <li>
            <a href={`#${g.id}`} data-spy={g.id}>
              <img class="cellar-index__flor" src={g.flor} alt="" aria-hidden="true" width="30" height="30" />
              <span class="cellar-index__name">{g.titulo}</span>
            </a>
          </li>
        ))}
      </ol>
    </aside>

    <div class="cellar-body">
      {grupos.map((g) => (
        <section class="wine-cat" id={g.id} aria-labelledby={`${g.id}-h`}>
          <div class="wine-cat__head">
            <span class="wine-cat__flor-wrap" data-parallax="0.1" aria-hidden="true">
              <img class="wine-cat__flor" src={g.flor} alt="" loading="lazy" />
            </span>
            <div class="wine-cat__headtext">
              <h2 class="wine-cat__title reveal" id={`${g.id}-h`}>{g.titulo}</h2>
              <p class="wine-cat__note reveal">{g.nota}</p>
            </div>
          </div>
          <ul class="wine-list">
            {g.vinos.map((v) => (
              <li class="wine-row reveal">
                <span class="wine-row__name">{v.nombre}</span>
                <span class="wine-row__grape">{v.uva}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>

  <!-- CÓMO ELEGIMOS -->
  <section class="cellar-intro">
    <h2 class="reveal">Cómo elegimos un vino</h2>
    <p class="reveal">
      No buscamos etiquetas conocidas. Buscamos vinos con personalidad, elaborados por
      productores que trabajan con el mismo respeto por la temporada, el origen y el
      tiempo que define nuestra cocina.
    </p>
  </section>

  <section class="cta-band">
    <p class="eyebrow reveal">Maridaje</p>
    <h2 class="reveal">Copa a copa</h2>
    <p class="cta-band__lead reveal">Si prefieres dejarte guiar, el maridaje acompaña los quince pases con una selección de seis vinos que evoluciona junto al menú de temporada.</p>
    <p class="cta-band__price reveal">60 €</p>
    <a href="/reservas/" class="btn btn--solid btn--lg reveal">Reservar</a>
  </section>

  <MaridajePopup />
</Base>
