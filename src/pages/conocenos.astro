---
import Base from '../layouts/Base.astro';

// Schema.org: los dos chefs, con el MISMO @id que en el grafo base (Base.astro):
// las propiedades se fusionan y esta página aporta el detalle (EEAT: quiénes son,
// qué saben hacer, dónde encontrarlos).
const personSchema = `<script type="application/ld+json">${JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://pipilacha.es/#aran",
      "name": "Arán Rodrigo",
      "jobTitle": "Chef y cofundador",
      "worksFor": { "@id": "https://pipilacha.es/#restaurant" },
      "description": "Cofundador de Pipilacha. Trata las flores comestibles como ingrediente principal: sabor, técnica y origen en cada pase.",
      "image": "https://pipilacha.es/assets/img/chef-1.jpg",
      "mainEntityOfPage": "https://pipilacha.es/conocenos/",
      "sameAs": ["https://instagram.com/restaurante.pipilacha"]
    },
    {
      "@type": "Person",
      "@id": "https://pipilacha.es/#noe",
      "name": "Noé David",
      "jobTitle": "Chef y cofundador",
      "worksFor": { "@id": "https://pipilacha.es/#restaurant" },
      "description": "Cofundador de Pipilacha. Investiga qué pasa cuando las flores se fermentan, se secan o se convierten en harina.",
      "image": "https://pipilacha.es/assets/img/chef-2.jpg",
      "mainEntityOfPage": "https://pipilacha.es/conocenos/",
      "sameAs": ["https://instagram.com/restaurante.pipilacha"]
    }
  ]
})}</script>`;
---

<Base
  title="Conócenos · Arán y Noé · Pipilacha Madrid"
  description="Arán Rodrigo y Noé David tratan las flores comestibles como un ingrediente de verdad: sabor, técnica y origen de cada plato en Pipilacha, Madrid."
  schema={personSchema}
>

  <section class="page-header">
    <p class="eyebrow">Conócenos</p>
    <h1 class="reveal-head">Todo empieza<br>con una pregunta</h1>
  </section>

  <!-- CONCEPTO / CHEFS -->
  <section class="concepto" id="concepto">
    <div class="concepto__imgs">
      <figure class="concepto__img concepto__img--a" data-parallax="0.12">
        <img src="/assets/img/chef-1.jpg" width="880" height="1100" decoding="async" alt="Arán Rodrigo, cofundador y chef" />
      </figure>
      <figure class="concepto__img concepto__img--b" data-parallax="0.22">
        <img src="/assets/img/chef-2.jpg" width="880" height="1100" decoding="async" alt="Noé David, cofundador y chef" />
      </figure>
    </div>
    <div class="concepto__text" data-reveal-stagger>
      <p class="reveal">Las flores llevan siglos en la cocina. Como adorno, como guiño, como firma visual de quien quiere que el plato quede bonito en foto.</p>
      <p class="reveal">Nosotros nos preguntamos qué pasa cuando las tratas como un ingrediente de verdad. Con el mismo rigor con el que otros trabajan la carne, el pescado o el vegetal. Qué sabores tienen, cómo se comportan con el calor, qué ocurre cuando las fermentas, las secas o las conviertes en harina.</p>
      <p class="reveal">Hay miles de flores comestibles. Llevamos tiempo trabajando con ellas. Y todavía nos queda mucho por descubrir.</p>
      <div class="concepto__signs reveal">
        <div><strong>Arán Rodrigo</strong><span>Cofundador &amp; Chef</span></div>
        <div><strong>Noé David</strong><span>Cofundador &amp; Chef</span></div>
      </div>
    </div>
    <img src="/assets/img/petal-fig.png" class="petal petal--1" alt="" aria-hidden="true" />
  </section>

  <!-- SHOWCOOKING / LA BARRA -->
  <section class="showcooking" id="showcooking">
    <figure class="showcooking__img reveal">
      <img src="/assets/img/noe-barra.jpg" width="1200" height="1600" loading="lazy" decoding="async" alt="Noé David apoyado en la barra, con el delantal de Pipilacha" />
    </figure>
    <div class="showcooking__text">
      <p class="eyebrow reveal">Showcooking</p>
      <h2 class="reveal">Cocinamos de cara</h2>
      <p class="reveal">Ocho asientos en la barra, frente a la cocina abierta. Cada plato se termina delante de ti y quien lo cocina te cuenta qué flor lleva, qué hace en el plato y de dónde salió la idea. Nos turnamos: uno cocina, el otro habla.</p>
      <p class="reveal">Con dieciséis personas por servicio nos da tiempo a saber tu nombre.</p>
      <a href="/reservas/" class="btn btn--solid reveal">Reservar</a>
    </div>
  </section>

</Base>
