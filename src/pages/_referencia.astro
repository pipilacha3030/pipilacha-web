---
// Página de referencia (ritmo estilo letsplayfight.com, adaptado a Pipilacha).
// Hero fijo (pin): al hacer scroll, una foto crece a pantalla completa mientras
// las demás se apartan y se desenfocan. Standalone, no enlazada en la nav. noindex.
import '../styles/main.css';

// Fotos dispersas (las que se apartan + blur). Lejos del centro para no tapar el texto.
const chips = [
  { src: '/assets/img/chef-1.jpg', alt: 'Retrato en la cocina de Pipilacha', pos: 'top:8%;  left:11%', w: 'clamp(140px,13vw,250px)', ratio: '3/4'  },
  { src: '/assets/img/g8.jpg',     alt: 'Vieira con flor de higo',           pos: 'top:10%; right:6%', w: 'clamp(190px,18vw,360px)', ratio: '16/9' },
  { src: '/assets/img/dish-1.jpg', alt: 'Guisante y flor de saúco',          pos: 'top:40%; left:5%',  w: 'clamp(150px,14vw,280px)', ratio: '4/3'  },
  { src: '/assets/img/g3.jpg',     alt: 'Pase de flores en el plato',        pos: 'top:38%; right:4%', w: 'clamp(180px,16vw,320px)', ratio: '16/9' },
  { src: '/assets/img/g6.jpg',     alt: 'Servicio en cocina',                pos: 'top:76%; left:13%', w: 'clamp(120px,11vw,210px)', ratio: '5/4'  },
  { src: '/assets/img/g9.jpg',     alt: 'Los chefs en el pase',              pos: 'top:74%; right:8%', w: 'clamp(190px,17vw,340px)', ratio: '16/9' },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pipilacha · Referencia</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href="/assets/img/petal-fig.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Hanken+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="pf">

  <header class="pf__bar">
    <a href="/" class="pf__logo" aria-label="Pipilacha inicio">
      <img src="/assets/img/logo-dark.png" alt="Pipilacha" />
    </a>
    <button class="pf__burger" type="button" aria-label="Menú"><span></span><span></span></button>
  </header>

  <span class="pf__side">Hecho en Madrid</span>

  <section class="pf__hero" id="hero">

    {chips.map(c => (
      <figure class="pf__chip" style={`${c.pos}; width:${c.w}; aspect-ratio:${c.ratio};`}>
        <img src={c.src} alt={c.alt} loading="eager" />
      </figure>
    ))}

    <div class="pf__center" id="center">
      <h1>La flor como ingrediente.</h1>
      <p>Cocina de flores · Madrid · Quince pases<span class="pf__cursor" aria-hidden="true"></span></p>
    </div>

    <!-- foto destacada: arranca más abajo (como la referencia) y crece a pantalla completa -->
    <div class="pf__featured-anchor">
      <figure class="pf__featured" id="featured">
        <img src="/assets/img/hero.jpg" alt="Cuenco de flores comestibles de Pipilacha" />
        <span class="pf__scrim" aria-hidden="true"></span>
      </figure>
    </div>

    <div class="pf__final" id="final">
      <span class="pf__final-eyebrow">La barra · 8 de 16 plazas</span>
      <span class="pf__final-line">Frente a la cocina, donde se termina cada pase delante de ti.</span>
      <a class="pf__final-cta" href="/reservas/">Reservar</a>
    </div>

  </section>

  <style>
    .pf{background:var(--cream);overflow-x:hidden;position:relative}
    .pf__bar{position:fixed;top:0;left:0;width:100%;display:flex;justify-content:space-between;align-items:center;padding:1.5rem clamp(1.25rem,4vw,3rem);z-index:20}
    .pf__logo img{height:30px;width:auto;object-fit:contain}
    .pf__burger{display:flex;flex-direction:column;gap:6px;background:none;border:0;cursor:pointer;padding:6px}
    .pf__burger span{width:26px;height:2px;background:var(--moss)}
    .pf__side{position:fixed;right:.45rem;top:50%;transform:translateY(-50%);writing-mode:vertical-rl;font-family:var(--sans);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--moss);opacity:.6;z-index:20}

    .pf__hero{position:relative;width:100%;height:100vh;min-height:600px;overflow:hidden}

    .pf__chip{position:absolute;margin:0;overflow:hidden;border-radius:10px;background:var(--cloud);box-shadow:0 26px 55px -28px rgba(49,51,31,.5);z-index:1;will-change:transform,filter,opacity}
    .pf__chip img{width:100%;height:100%;object-fit:cover}

    /* caja centrada en el viewport; la foto interna se desplaza/escala con scroll */
    .pf__featured-anchor{position:absolute;inset:0;margin:auto;width:clamp(260px,28vw,500px);height:max-content;aspect-ratio:16/9;z-index:2}
    .pf__featured{position:relative;width:100%;height:100%;margin:0;overflow:hidden;border-radius:10px;background:var(--cloud);box-shadow:0 30px 60px -30px rgba(49,51,31,.55);will-change:transform,border-radius}
    .pf__featured img{width:100%;height:100%;object-fit:cover}
    .pf__scrim{position:absolute;inset:0;opacity:0;background:linear-gradient(180deg,rgba(20,20,12,.1) 0%,rgba(20,20,12,.6) 100%)}

    /* titular: arriba y con la zona despejada para leerse */
    .pf__center{position:absolute;left:50%;transform:translateX(-50%);top:21%;width:min(640px,58vw);text-align:center;z-index:3}
    .pf__center h1{font-family:var(--serif);font-weight:400;color:var(--moss);font-size:clamp(2.2rem,5vw,4.2rem);line-height:1.04}
    .pf__center p{margin-top:1.2rem;font-family:var(--sans);font-weight:500;color:var(--ink);font-size:clamp(.95rem,1.4vw,1.15rem)}
    .pf__cursor{display:inline-block;width:.6em;height:1em;background:var(--moss);vertical-align:-.1em;margin-left:.35em;animation:pfBlink 1s steps(1) infinite}
    @keyframes pfBlink{50%{opacity:0}}

    .pf__final{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;text-align:center;padding:0 1.5rem;z-index:4;opacity:0;pointer-events:none}
    .pf__final-eyebrow{font-family:var(--sans);font-size:.72rem;letter-spacing:.24em;text-transform:uppercase;color:var(--cream);opacity:.9}
    .pf__final-line{font-family:var(--serif);font-size:clamp(1.6rem,3.4vw,2.8rem);line-height:1.15;color:var(--cream);max-width:18ch}
    .pf__final-cta{margin-top:.6rem;font-family:var(--sans);font-weight:500;font-size:.9rem;letter-spacing:.16em;text-transform:uppercase;color:var(--moss);background:var(--cream);padding:1.05em 3em;border-radius:var(--radius-btn);transition:background .4s var(--ease),color .4s var(--ease)}
    .pf__final-cta:hover{background:var(--terracotta);color:var(--cream)}
    .pf--ready .pf__final{pointer-events:auto}
    .pf--static .pf__final{opacity:1}

    /* fallback sin JS / reduce-motion / móvil: hero estático legible */
    @media (max-width:760px){
      .pf__hero{height:auto;min-height:100vh;display:flex;flex-direction:column;align-items:center;gap:1.6rem;padding:7rem 1.25rem 3rem}
      .pf__chip{position:relative;top:auto !important;left:auto !important;right:auto !important;width:min(78vw,360px) !important}
      .pf__featured-anchor{position:relative;inset:auto;margin:0;width:min(88vw,520px)}
      .pf__center{position:relative;top:auto;left:auto;transform:none;width:auto;order:-1}
      .pf__final{position:relative;inset:auto;opacity:1;gap:.7rem;margin-top:.5rem}
      .pf__final-eyebrow{color:var(--terracotta)}
      .pf__final-line{color:var(--moss)}
      .pf__scrim{display:none}
    }
  </style>

  <script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script is:inline src="/js/referencia.js?v=4"></script>

</body>
</html>
